# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules

# next.js
/.next/
/out/

# production
/build

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example

# row dumps that contain password hashes
/jiravision-user-*-backup.json

# row dumps written by scripts/purge-demo-data.mjs before it deletes anything
/backups/

# user uploads
/public/uploads/*
!/public/uploads/README.md

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
# Runtime data-layer storage (created by lib/data adapters; never commit user submissions)
/data/

# playwright artifacts
test-results/
playwright-report/
.neon

# scratch scripts used for one-off provider/API checks
.tmp-*.mjs
