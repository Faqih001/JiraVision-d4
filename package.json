{
  "name": "jiravision",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint app components lib hooks types context",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "drizzle:push": "dotenv -e .env -- drizzle-kit push",
    "db:generate": "npx drizzle-kit generate",
