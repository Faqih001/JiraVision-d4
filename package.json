    "db:playbooks:rollback": "node scripts/rollback-playbooks-tables.mjs",
    "db:apply": "node -r dotenv/config ./drizzle/apply-schema.js",
    "db:fix": "node -r dotenv/config ./drizzle/create-missing-tables.js",
    "db:seed": "node -r dotenv/config ./drizzle/add-sample-data.js",
    "seed:chats": "node drizzle/seed-chats.js",
    "neon:setup": "echo 'Run the neon-setup.sql file in your Neon SQL Editor'",
