{
  "schemaVersion": 1,
  "discipline": {
    "key": "developer",
    "label": "Developer",
    "category": "technology",
    "categoryLabel": "Software, IT & digital",
    "focus": "Build, review, release and maintain software"
  },
  "pack": {
    "key": "developer",
    "reportTemplate": "engineering",
    "registerKinds": [
      "Code repositories",
      "Pull requests",
      "Technical debt",
      "Sprint backlog"
    ],
    "ladderDiscipline": {
      "proposed": "developer",
      "verifyIn": "lib/auto-populate.ts"
    }
  },
  "provenance": {
    "type": "proposed-seed",
    "sourceDocument": null,
    "reviewRequired": true,
    "reviewerRole": "experienced developer practitioner",
    "note": "Starting seed written without a source document. Not professional, clinical, legal, financial or safety advice. A practitioner must review before use.",
    "detailLevel": "detailed"
  },
  "method": {
    "resolveAtRuntime": "getMethodForDiscipline(pack, discipline)",
    "documentedSequence": [
      "Plan",
      "Code",
      "Review",
      "Test",
      "Deploy",
      "Monitor"
    ],
    "documentedIn": "roles doc section 4.7 (verify in code)"
  },
  "surfaces": {
    "overview": {
      "path": "/dashboard/ops",
      "kpis": [
        {
          "id": "release_success_rate",
          "label": "Release success rate",
          "source": "releases",
          "sourceType": "log",
          "aggregation": "rate",
          "defaultTarget": null,
          "computedBy": "code"
        },
        {
          "id": "escaped_defects",
          "label": "Escaped defects",
          "source": "defects",
          "sourceType": "log",
          "aggregation": "count",
          "defaultTarget": null,
          "computedBy": "code"
        },
        {
          "id": "open_critical_defects",
          "label": "Open critical defects",
          "source": "defects",
          "sourceType": "log",
          "aggregation": "open_count",
          "defaultTarget": null,
          "computedBy": "code"
        },
        {
          "id": "technical_debt_items",
          "label": "Technical debt items",
          "source": "technical_debt",
          "sourceType": "register",
          "aggregation": "count",
          "defaultTarget": null,
          "computedBy": "code"
        }
      ],
      "recommendRules": [
        {
          "id": "pr_open_over_3_days",
          "when": "PR open over 3 days",
          "suggest": "nudge reviewer",
          "deterministic": true
        },
        {
          "id": "release_rolled_back",
          "when": "release rolled back",
          "suggest": "add post-mortem",
          "deterministic": true
        },
        {
          "id": "repo_without_ci_status",
          "when": "repo without CI status",
          "suggest": "record",
          "deterministic": true
        }
      ]
    },
    "logs": {
      "path": "/dashboard/ops/logs",
      "entities": [
        {
          "key": "releases",
          "label": "Releases",
          "fields": [
            {
              "key": "release_date",
              "type": "date"
            },
            {
              "key": "version",
              "type": "text"
            },
            {
              "key": "environment",
              "type": "enum",
              "values": [
                "dev",
                "staging",
                "production"
              ]
            },
            {
              "key": "result",
              "type": "enum",
              "values": [
                "success",
                "failed",
                "rolled_back"
              ]
            },
            {
              "key": "rollback_reason",
              "type": "text"
            }
          ]
        },
        {
          "key": "defects",
          "label": "Defects",
          "fields": [
            {
              "key": "found_date",
              "type": "date"
            },
            {
              "key": "severity",
              "type": "enum",
              "values": [
                "low",
                "medium",
                "high",
                "critical"
              ]
            },
            {
              "key": "escaped",
              "type": "enum",
              "values": [
                "yes",
                "no"
              ]
            },
            {
              "key": "status",
              "type": "enum",
              "values": [
                "open",
                "fixed",
                "wont_fix"
              ]
            },
            {
              "key": "fixed_date",
              "type": "date"
            }
          ]
        },
        {
          "key": "daily_checklist",
          "label": "Daily checklist",
          "fields": [
            {
              "key": "date",
              "type": "date"
            },
            {
              "key": "completed_by",
              "type": "text"
            },
            {
              "key": "pull_latest_changes_and_check_ci_status",
              "type": "enum",
              "values": [
                "yes",
                "no",
                "n_a"
              ],
              "label": "Pull latest changes and check CI status"
            },
            {
              "key": "review_assigned_pull_requests",
              "type": "enum",
              "values": [
                "yes",
                "no",
                "n_a"
              ],
              "label": "Review assigned pull requests"
            },
            {
              "key": "work_planned_tasks_and_update_the_board",
              "type": "enum",
              "values": [
                "yes",
                "no",
                "n_a"
              ],
              "label": "Work planned tasks and update the board"
            },
            {
              "key": "respond_to_review_comments",
              "type": "enum",
              "values": [
                "yes",
                "no",
                "n_a"
              ],
              "label": "Respond to review comments"
            },
            {
              "key": "check_error_and_monitoring_alerts",
              "type": "enum",
              "values": [
                "yes",
                "no",
                "n_a"
              ],
              "label": "Check error and monitoring alerts"
            },
            {
              "key": "update_ticket_status",
              "type": "enum",
              "values": [
                "yes",
                "no",
                "n_a"
              ],
              "label": "Update ticket status"
            }
          ]
        },
        {
          "key": "weekly_checklist",
          "label": "Weekly checklist",
          "fields": [
            {
              "key": "week_starting",
              "type": "date"
            },
            {
              "key": "completed_by",
              "type": "text"
            },
            {
              "key": "sprint_planning_or_refinement",
              "type": "enum",
              "values": [
                "yes",
                "no",
                "n_a"
              ],
              "label": "Sprint planning or refinement"
            },
            {
              "key": "dependency_and_security_alerts_review",
              "type": "enum",
              "values": [
                "yes",
                "no",
                "n_a"
              ],
              "label": "Dependency and security alerts review"
            },
            {
              "key": "clean_up_branches_and_stale_prs",
              "type": "enum",
              "values": [
                "yes",
                "no",
                "n_a"
              ],
              "label": "Clean up branches and stale PRs"
            },
            {
              "key": "demo_or_share_progress",
              "type": "enum",
              "values": [
                "yes",
                "no",
                "n_a"
              ],
              "label": "Demo or share progress"
            },
            {
              "key": "update_documentation_for_changes",
              "type": "enum",
              "values": [
                "yes",
                "no",
                "n_a"
              ],
              "label": "Update documentation for changes"
            },
            {
              "key": "back_up_local_work_and_notes",
              "type": "enum",
              "values": [
                "yes",
                "no",
                "n_a"
              ],
              "label": "Back up local work and notes"
            }
          ]
        }
      ]
    },
    "registers": {
      "path": "/dashboard/registers",
      "items": [
        {
          "kind": "Code repositories",
          "track": [
            "repo owner",
            "default branch",
            "CI status"
          ]
        },
        {
          "kind": "Pull requests",
          "track": [
            "open PRs",
            "reviewers"
          ]
        },
        {
          "kind": "Technical debt",
          "track": [
            "debt items",
            "impact"
          ]
        },
        {
          "kind": "Sprint backlog",
          "track": [
            "sprint items"
          ]
        }
      ],
      "documentationCategories": [
        "Repository inventory",
        "Release log and changelog",
        "Defect log",
        "Architecture notes",
        "Runbooks",
        "Post-mortems"
      ]
    },
    "playbooks": {
      "path": "/dashboard/playbooks",
      "seeds": [
        {
          "key": "code_review",
          "title": "Code review",
          "frequency": "daily",
          "phasesFrom": "custom",
          "phases": [
            {
              "name": "Steps",
              "steps": [
                "Read the description and linked ticket",
                "Check for correctness and edge cases",
                "Check tests and coverage",
                "Check security and performance",
                "Leave clear comments",
                "Approve or request changes"
              ]
            }
          ],
          "methodTagging": "work-log entries may be tagged with a phase from getMethodForDiscipline"
        },
        {
          "key": "release_checklist",
          "title": "Release checklist",
          "frequency": "weekly",
          "phasesFrom": "custom",
          "phases": [
            {
              "name": "Steps",
              "steps": [
                "Confirm all tickets are merged and tested",
                "Update version and changelog",
                "Run the full test suite",
                "Deploy to staging and smoke test",
                "Deploy to production",
                "Monitor and be ready to roll back",
                "Record the release"
              ]
            }
          ],
          "methodTagging": "work-log entries may be tagged with a phase from getMethodForDiscipline"
        },
        {
          "key": "incident_response",
          "title": "Incident response",
          "frequency": "as_needed",
          "phasesFrom": "custom",
          "phases": [
            {
              "name": "Steps",
              "steps": [
                "Acknowledge and assess impact",
                "Mitigate or roll back",
                "Communicate status",
                "Find the root cause",
                "Fix and test",
                "Write the post-mortem"
              ]
            }
          ],
          "methodTagging": "work-log entries may be tagged with a phase from getMethodForDiscipline"
        },
        {
          "key": "dependency_and_security_update",
          "title": "Dependency and security update",
          "frequency": "monthly",
          "phasesFrom": "custom",
          "phases": [
            {
              "name": "Steps",
              "steps": [
                "List outdated and vulnerable packages",
                "Prioritise by risk",
                "Update in small batches",
                "Run tests",
                "Deploy and monitor"
              ]
            }
          ],
          "methodTagging": "work-log entries may be tagged with a phase from getMethodForDiscipline"
        },
        {
          "key": "escalation",
          "title": "Escalation",
          "frequency": "as_needed",
          "phasesFrom": "custom",
          "triggers": [
            "Production outage",
            "Security vulnerability in production",
            "Data loss or corruption",
            "Failed release that cannot be rolled back",
            "Credential leak"
          ],
          "recordFields": [
            "date_time",
            "affected_area_or_system",
            "people_affected_by_code_or_count",
            "description",
            "actions_taken",
            "evidence_or_logs",
            "impact",
            "person_or_party_contacted",
            "current_status"
          ],
          "rules": [
            "Record facts; escalate promptly when a trigger is met"
          ]
        },
        {
          "key": "role_handover",
          "title": "Role handover",
          "frequency": "as_needed",
          "phasesFrom": "custom",
          "phases": [
            {
              "name": "Handover",
              "steps": [
                "Transfer Code repositories: repo owner, default branch, CI status",
                "Transfer Pull requests: open PRs, reviewers",
                "Transfer Technical debt: debt items, impact",
                "Transfer Sprint backlog: sprint items",
                "List open work, deadlines and commitments",
                "Share trackers, templates and contacts",
                "Transfer accounts and access only through the approved secure process, never in documents",
                "Brief the successor and confirm access",
                "Review progress after one week"
              ]
            }
          ]
        }
      ]
    },
    "tasks": {
      "path": "/dashboard/tasks",
      "recurringTemplates": [
        {
          "title": "Pull latest changes and check CI status",
          "frequency": "daily"
        },
