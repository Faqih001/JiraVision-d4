        "Feature request log",
        "Release notes",
        "Experiment results",
        "Customer research notes"
      ]
    },
    "playbooks": {
      "path": "/dashboard/playbooks",
      "seeds": [
        {
          "key": "backlog_grooming",
          "title": "Backlog grooming",
          "frequency": "weekly",
          "phasesFrom": "custom",
          "phases": [
            {
              "name": "Steps",
              "steps": [
                "Collect new requests and feedback",
                "Remove duplicates and stale items",
                "Clarify value and acceptance criteria",
                "Estimate with the team",
                "Prioritise and order"
              ]
            }
          ],
          "methodTagging": "work-log entries may be tagged with a phase from getMethodForDiscipline"
        },
        {
          "key": "release_readiness_check",
          "title": "Release readiness check",
          "frequency": "weekly",
          "phasesFrom": "custom",
          "phases": [
            {
              "name": "Steps",
              "steps": [
                "Confirm scope and acceptance criteria are met",
                "Check test and sign-off status",
                "Confirm documentation and support are ready",
                "Agree go or no-go",
                "Record the decision"
              ]
            }
          ],
          "methodTagging": "work-log entries may be tagged with a phase from getMethodForDiscipline"
        },
        {
          "key": "feature_discovery",
          "title": "Feature discovery",
          "frequency": "as_needed",
          "phasesFrom": "custom",
          "phases": [
            {
              "name": "Steps",
              "steps": [
                "Define the problem and target users",
                "Gather evidence from users and data",
                "Explore options",
                "Test the riskiest assumption",
                "Decide whether to build"
              ]
            }
          ],
          "methodTagging": "work-log entries may be tagged with a phase from getMethodForDiscipline"
        },
        {
          "key": "post_launch_review",
          "title": "Post-launch review",
          "frequency": "as_needed",
          "phasesFrom": "custom",
          "phases": [
            {
              "name": "Steps",
              "steps": [
                "Compare results to goals",
                "Collect user feedback",
                "Review defects and incidents",
                "Decide follow-up",
                "Record learnings"
              ]
            }
          ],
          "methodTagging": "work-log entries may be tagged with a phase from getMethodForDiscipline"
        },
        {
          "key": "escalation",
          "title": "Escalation",
          "frequency": "as_needed",
          "phasesFrom": "custom",
          "triggers": [
            "Launch blocker found",
            "Data privacy concern",
            "Major customer churn risk",
            "Scope change affecting commitments",
            "Conflicting stakeholder demands"
          ],
          "recordFields": [
            "date_time",
            "affected_area_or_system",
            "people_affected_by_code_or_count",
            "description",
            "actions_taken",
            "evidence_or_logs",
            "impact",
            "person_or_party_contacted",
            "current_status"
          ],
          "rules": [
            "Record facts; escalate promptly when a trigger is met"
          ]
        },
        {
          "key": "role_handover",
          "title": "Role handover",
          "frequency": "as_needed",
          "phasesFrom": "custom",
          "phases": [
            {
              "name": "Handover",
              "steps": [
                "Transfer Initiatives: roadmap items",
                "Transfer Stakeholders: customers and sponsors",
                "Transfer Risks: product risks",
                "List open work, deadlines and commitments",
                "Share trackers, templates and contacts",
                "Transfer accounts and access only through the approved secure process, never in documents",
                "Brief the successor and confirm access",
                "Review progress after one week"
              ]
            }
          ]
        }
      ]
    },
