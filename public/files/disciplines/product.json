    "registers": {
      "path": "/dashboard/registers",
      "items": [
        {
          "kind": "Initiatives",
          "track": [
            "roadmap items"
          ]
        },
        {
          "kind": "Stakeholders",
          "track": [
            "customers and sponsors"
          ]
        },
        {
          "kind": "Risks",
