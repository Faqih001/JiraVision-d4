            },
            {
              "key": "completed_by",
              "type": "text"
            },
            {
              "key": "backlog_grooming_session",
              "type": "enum",
              "values": [
                "yes",
                "no",
                "n_a"
              ],
              "label": "Backlog grooming session"
            },
            {
              "key": "sprint_or_release_planning",
              "type": "enum",
