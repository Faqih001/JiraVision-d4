{
  "schemaVersion": 1,
  "discipline": {
    "key": "product",
    "label": "Product",
    "category": "delivery",
    "categoryLabel": "Management & project delivery",
    "focus": "Roadmap, requirements and releases"
  },
  "pack": {
    "key": "management",
    "reportTemplate": "general",
    "registerKinds": [
      "Initiatives",
      "Stakeholders",
      "Risks",
      "Reports"
    ],
    "ladderDiscipline": {
      "proposed": "coordinator",
      "verifyIn": "lib/auto-populate.ts"
    }
  },
  "provenance": {
    "type": "proposed-seed",
    "sourceDocument": null,
    "reviewRequired": true,
    "reviewerRole": "experienced product practitioner",
    "note": "Starting seed written without a source document. Not professional, clinical, legal, financial or safety advice. A practitioner must review before use.",
    "detailLevel": "detailed"
  },
  "method": {
    "resolveAtRuntime": "getMethodForDiscipline(pack, discipline)",
    "documentedSequence": null,
    "documentedIn": null
  },
  "surfaces": {
    "overview": {
      "path": "/dashboard/ops",
      "kpis": [
        {
          "id": "requests_triaged",
          "label": "Requests triaged",
          "source": "feature_requests",
          "sourceType": "log",
          "aggregation": "count",
          "defaultTarget": null,
          "computedBy": "code"
        },
        {
          "id": "roadmap_items_delivered",
          "label": "Roadmap items delivered",
          "source": "initiatives",
          "sourceType": "register",
          "aggregation": "rate",
          "defaultTarget": null,
          "computedBy": "code"
        },
        {
          "id": "open_high_priority_requests",
          "label": "Open high-priority requests",
          "source": "feature_requests",
          "sourceType": "log",
          "aggregation": "open_count",
          "defaultTarget": null,
          "computedBy": "code"
        },
        {
          "id": "go_no_go_decisions_logged",
          "label": "Go/no-go decisions logged",
          "source": "release_decisions",
          "sourceType": "log",
          "aggregation": "count",
          "defaultTarget": null,
          "computedBy": "code"
        }
      ],
      "recommendRules": [
        {
          "id": "high_priority_request_untriaged_for_7_days",
          "when": "high-priority request untriaged for 7 days",
          "suggest": "triage it",
          "deterministic": true
        },
        {
          "id": "release_without_go_no_go_record",
          "when": "release without go/no-go record",
          "suggest": "record decision",
          "deterministic": true
        }
      ]
    },
    "logs": {
      "path": "/dashboard/ops/logs",
      "entities": [
        {
          "key": "feature_requests",
          "label": "Feature requests",
          "fields": [
            {
              "key": "received_date",
              "type": "date"
            },
            {
              "key": "source",
              "type": "text"
            },
            {
              "key": "request",
              "type": "text"
            },
            {
              "key": "priority",
              "type": "enum",
              "values": [
                "low",
                "medium",
                "high"
              ]
            },
            {
              "key": "status",
              "type": "enum",
              "values": [
                "new",
                "planned",
                "shipped",
                "declined"
              ]
            }
          ]
        },
        {
          "key": "release_decisions",
          "label": "Release decisions",
          "fields": [
            {
              "key": "decision_date",
              "type": "date"
            },
            {
              "key": "release",
              "type": "text"
            },
            {
              "key": "go_no_go",
              "type": "enum",
              "values": [
                "go",
                "no_go"
              ]
            },
            {
              "key": "reason",
              "type": "text"
            }
          ]
        },
        {
          "key": "daily_checklist",
