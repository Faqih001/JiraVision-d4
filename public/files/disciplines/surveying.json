  "surfaces": {
    "overview": {
      "path": "/dashboard/ops",
      "kpis": [
        {
          "id": "jobs_delivered",
          "label": "Jobs delivered",
          "source": "survey_jobs",
          "sourceType": "log",
          "aggregation": "count",
          "defaultTarget": null,
          "computedBy": "code"
        },
        {
          "id": "jobs_in_progress",
          "label": "Jobs in progress",
          "source": "survey_jobs",
          "sourceType": "log",
          "aggregation": "open_count",
          "defaultTarget": null,
          "computedBy": "code"
        },
        {
          "id": "closures_outside_tolerance",
          "label": "Closures outside tolerance",
          "source": "control_checks",
          "sourceType": "log",
          "aggregation": "count",
          "defaultTarget": null,
          "computedBy": "code"
        },
        {
          "id": "projects",
          "label": "Projects",
          "source": "projects",
          "sourceType": "register",
          "aggregation": "count",
          "defaultTarget": null,
          "computedBy": "code"
        }
      ],
      "recommendRules": [
        {
          "id": "closure_outside_tolerance",
          "when": "closure outside tolerance",
          "suggest": "resurvey",
          "deterministic": true
        },
        {
          "id": "equipment_calibration_due",
          "when": "equipment calibration due",
          "suggest": "calibrate",
          "deterministic": true
        }
      ]
    },
