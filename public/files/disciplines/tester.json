{
  "schemaVersion": 1,
  "discipline": {
    "key": "tester",
    "label": "Tester",
    "category": "technology",
    "categoryLabel": "Software, IT & digital",
    "focus": "Test runs, defects and release sign-off"
  },
  "pack": {
    "key": "developer",
    "reportTemplate": "engineering",
    "registerKinds": [
      "Code repositories",
      "Pull requests",
      "Technical debt",
      "Sprint backlog"
    ],
    "ladderDiscipline": {
      "proposed": "developer",
      "verifyIn": "lib/auto-populate.ts"
    }
  },
  "provenance": {
    "type": "proposed-seed",
    "sourceDocument": null,
    "reviewRequired": true,
    "reviewerRole": "experienced tester practitioner",
    "note": "Starting seed written without a source document. Not professional, clinical, legal, financial or safety advice. A practitioner must review before use.",
    "detailLevel": "detailed"
  },
  "method": {
    "resolveAtRuntime": "getMethodForDiscipline(pack, discipline)",
    "documentedSequence": [
      "Plan",
      "Design",
      "Execute",
      "Report",
      "Verify",
      "Close"
    ],
    "documentedIn": "roles doc section 4.7 (verify in code)"
  },
  "surfaces": {
    "overview": {
      "path": "/dashboard/ops",
      "kpis": [
        {
          "id": "test_runs_completed",
          "label": "Test runs completed",
          "source": "test_runs",
          "sourceType": "log",
          "aggregation": "count",
          "defaultTarget": null,
          "computedBy": "code"
        },
        {
          "id": "defects_open",
          "label": "Defects open",
          "source": "defect_reports",
          "sourceType": "log",
          "aggregation": "open_count",
          "defaultTarget": null,
          "computedBy": "code"
        },
        {
          "id": "defects_reopened",
          "label": "Defects reopened",
          "source": "defect_reports",
          "sourceType": "log",
          "aggregation": "count",
          "defaultTarget": null,
          "computedBy": "code"
        },
        {
          "id": "test_debt_items",
          "label": "Test debt items",
          "source": "technical_debt",
          "sourceType": "register",
          "aggregation": "count",
          "defaultTarget": null,
          "computedBy": "code"
        }
      ],
      "recommendRules": [
        {
          "id": "critical_defect_open_over_1_day",
          "when": "critical defect open over 1 day",
          "suggest": "escalate",
          "deterministic": true
        },
        {
          "id": "suite_failing_3_runs",
          "when": "suite failing 3 runs",
          "suggest": "investigate",
          "deterministic": true
        }
      ]
    },
    "logs": {
      "path": "/dashboard/ops/logs",
      "entities": [
        {
          "key": "test_runs",
          "label": "Test runs",
          "fields": [
            {
              "key": "run_date",
              "type": "date"
            },
            {
              "key": "suite",
              "type": "text"
            },
            {
              "key": "passed_count",
