            },
            {
              "key": "failed_count",
              "type": "number"
            },
            {
              "key": "blocked_count",
              "type": "number"
            }
          ]
        },
        {
          "key": "defect_reports",
          "label": "Defect reports",
          "fields": [
            {
              "key": "found_date",
              "type": "date"
            },
            {
              "key": "severity",
