    "playbooks": {
      "path": "/dashboard/playbooks",
      "seeds": [
        {
          "key": "regression_run",
          "title": "Regression run",
          "frequency": "daily",
          "phasesFrom": "custom",
          "phases": [
            {
              "name": "Steps",
              "steps": [
                "Confirm build and environment",
                "Run the suite",
                "Triage failures",
                "Log defects",
                "Report results"
              ]
            }
          ],
          "methodTagging": "work-log entries may be tagged with a phase from getMethodForDiscipline"
        },
        {
          "key": "defect_report",
          "title": "Defect report",
          "frequency": "as_needed",
          "phasesFrom": "custom",
          "phases": [
            {
              "name": "Steps",
              "steps": [
                "Reproduce the issue",
                "Capture steps, expected and actual results",
                "Add logs and screenshots",
                "Set severity and priority",
                "Assign and track"
              ]
            }
          ],
          "methodTagging": "work-log entries may be tagged with a phase from getMethodForDiscipline"
        },
        {
          "key": "release_sign_off",
          "title": "Release sign-off",
          "frequency": "weekly",
          "phasesFrom": "custom",
          "phases": [
            {
              "name": "Steps",
              "steps": [
                "Review coverage and open defects",
                "Check critical paths passed",
                "Confirm no blocking defects",
                "Record sign-off or conditions",
                "Share the summary"
              ]
            }
          ],
          "methodTagging": "work-log entries may be tagged with a phase from getMethodForDiscipline"
        },
        {
          "key": "test_case_design",
          "title": "Test case design",
          "frequency": "as_needed",
          "phasesFrom": "custom",
          "phases": [
            {
              "name": "Steps",
              "steps": [
                "Review requirements",
                "Identify scenarios and edge cases",
                "Write cases with data",
                "Review with peers",
                "Add to the suite"
              ]
            }
          ],
          "methodTagging": "work-log entries may be tagged with a phase from getMethodForDiscipline"
        },
        {
          "key": "escalation",
          "title": "Escalation",
          "frequency": "as_needed",
          "phasesFrom": "custom",
          "triggers": [
            "Critical defect found late",
            "Test environment unavailable",
            "Release pressure to skip tests",
            "Flaky tests hiding failures",
            "Data privacy issue in test data"
          ],
          "recordFields": [
            "date_time",
            "affected_area_or_system",
            "people_affected_by_code_or_count",
            "description",
            "actions_taken",
            "evidence_or_logs",
            "impact",
            "person_or_party_contacted",
            "current_status"
          ],
          "rules": [
            "Record facts; escalate promptly when a trigger is met"
          ]
        },
        {
          "key": "role_handover",
          "title": "Role handover",
          "frequency": "as_needed",
          "phasesFrom": "custom",
          "phases": [
            {
              "name": "Handover",
              "steps": [
                "Transfer Code repositories: test suites",
                "Transfer Technical debt: test debt",
                "Transfer Pull requests: changes under test",
                "Transfer Sprint backlog: test work",
                "List open work, deadlines and commitments",
                "Share trackers, templates and contacts",
                "Transfer accounts and access only through the approved secure process, never in documents",
                "Brief the successor and confirm access",
                "Review progress after one week"
              ]
            }
          ]
        }
      ]
