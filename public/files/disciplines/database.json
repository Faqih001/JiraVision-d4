    "playbooks": {
      "path": "/dashboard/playbooks",
      "seeds": [
        {
          "key": "backup_procedure",
          "title": "Backup procedure",
          "frequency": "daily",
          "phasesFrom": "custom",
          "phases": [
            {
              "name": "Steps",
              "steps": [
                "Confirm backup system and storage",
                "Run or verify the scheduled backup",
                "Check completion and size",
                "Verify integrity",
                "Record the result in the log"
              ]
            }
          ],
          "methodTagging": "work-log entries may be tagged with a phase from getMethodForDiscipline"
        },
        {
          "key": "restore_test",
          "title": "Restore test",
          "frequency": "monthly",
          "phasesFrom": "custom",
          "phases": [
            {
              "name": "Steps",
              "steps": [
                "Pick a database and backup",
                "Restore to a test server",
                "Check data and row counts",
                "Compare with source",
                "Record time taken and result"
              ]
            }
          ],
          "methodTagging": "work-log entries may be tagged with a phase from getMethodForDiscipline"
        },
        {
          "key": "slow_query_investigation",
          "title": "Slow query investigation",
          "frequency": "as_needed",
          "phasesFrom": "custom",
          "phases": [
            {
              "name": "Steps",
              "steps": [
                "Capture the query and plan",
                "Check indexes and statistics",
                "Test changes in non-production",
                "Apply and measure",
                "Record"
              ]
            }
          ],
          "methodTagging": "work-log entries may be tagged with a phase from getMethodForDiscipline"
        },
        {
          "key": "schema_change",
          "title": "Schema change",
          "frequency": "as_needed",
          "phasesFrom": "custom",
          "phases": [
            {
              "name": "Steps",
              "steps": [
                "Review script and rollback",
                "Back up",
                "Apply in the window",
                "Validate",
                "Update documentation"
              ]
            }
          ],
          "methodTagging": "work-log entries may be tagged with a phase from getMethodForDiscipline"
        },
        {
          "key": "escalation",
          "title": "Escalation",
          "frequency": "as_needed",
          "phasesFrom": "custom",
          "triggers": [
            "Backup failed repeatedly",
            "Database unavailable",
            "Corruption detected",
            "Replication broken",
            "Unauthorised access"
          ],
          "recordFields": [
            "date_time",
            "affected_area_or_system",
            "people_affected_by_code_or_count",
            "description",
            "actions_taken",
            "evidence_or_logs",
            "impact",
            "person_or_party_contacted",
            "current_status"
          ],
          "rules": [
            "Record facts; escalate promptly when a trigger is met"
          ]
        },
        {
          "key": "role_handover",
          "title": "Role handover",
          "frequency": "as_needed",
          "phasesFrom": "custom",
          "phases": [
            {
              "name": "Handover",
              "steps": [
                "Transfer Infrastructure: database servers",
                "Transfer Accounts and systems: database consoles (references only)",
                "Transfer Equipment: storage",
                "Transfer Outstanding work: maintenance tasks",
                "List open work, deadlines and commitments",
                "Share trackers, templates and contacts",
                "Transfer accounts and access only through the approved secure process, never in documents",
                "Brief the successor and confirm access",
                "Review progress after one week"
              ]
            }
          ]
        }
