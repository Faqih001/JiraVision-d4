{
  "schemaVersion": 1,
  "discipline": {
    "key": "database",
    "label": "Database",
    "category": "technology",
    "categoryLabel": "Software, IT & digital",
    "focus": "Backups, restores, performance and integrity"
  },
  "pack": {
    "key": "it-technician",
    "reportTemplate": "technical",
    "registerKinds": [
      "Infrastructure",
      "Accounts and systems",
      "Equipment",
      "Outstanding work"
    ],
    "ladderDiscipline": {
      "proposed": "technician",
      "verifyIn": "lib/auto-populate.ts"
    }
  },
  "provenance": {
    "type": "proposed-seed",
    "sourceDocument": null,
    "reviewRequired": true,
    "reviewerRole": "experienced database practitioner",
    "note": "Starting seed written without a source document. Not professional, clinical, legal, financial or safety advice. A practitioner must review before use.",
    "detailLevel": "detailed"
  },
  "method": {
    "resolveAtRuntime": "getMethodForDiscipline(pack, discipline)",
    "documentedSequence": [
      "Backup",
      "Monitor",
      "Optimize",
      "Restore",
      "Test",
      "Document"
    ],
    "documentedIn": "roles doc section 4.7 (verify in code)"
  },
  "surfaces": {
    "overview": {
      "path": "/dashboard/ops",
      "kpis": [
        {
          "id": "backup_success_rate",
          "label": "Backup success rate",
          "source": "backup_runs",
          "sourceType": "log",
          "aggregation": "rate",
          "defaultTarget": null,
          "computedBy": "code"
        },
        {
          "id": "backup_failures",
          "label": "Backup failures",
          "source": "backup_runs",
          "sourceType": "log",
          "aggregation": "count",
          "defaultTarget": null,
          "computedBy": "code"
        },
        {
          "id": "restore_tests_passed",
          "label": "Restore tests passed",
          "source": "restore_tests",
          "sourceType": "log",
          "aggregation": "count",
          "defaultTarget": null,
          "computedBy": "code"
        },
        {
          "id": "databases_tracked",
          "label": "Databases tracked",
          "source": "infrastructure",
          "sourceType": "register",
          "aggregation": "count",
          "defaultTarget": null,
          "computedBy": "code"
        }
      ],
      "recommendRules": [
        {
          "id": "no_successful_backup_in_24_hours",
          "when": "no successful backup in 24 hours",
          "suggest": "investigate",
          "deterministic": true
        },
        {
          "id": "no_restore_test_in_30_days",
          "when": "no restore test in 30 days",
          "suggest": "schedule one",
          "deterministic": true
        }
      ]
    },
    "logs": {
      "path": "/dashboard/ops/logs",
      "entities": [
