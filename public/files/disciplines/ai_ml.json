        "Model inventory",
        "Experiment tracking",
        "Dataset documentation",
        "Evaluation reports",
        "Deployment log",
        "Responsible AI assessments"
      ]
    },
    "playbooks": {
      "path": "/dashboard/playbooks",
      "seeds": [
        {
          "key": "experiment_cycle",
          "title": "Experiment cycle",
          "frequency": "weekly",
          "phasesFrom": "custom",
          "phases": [
            {
              "name": "Steps",
              "steps": [
                "State hypothesis and metric",
                "Prepare data and split",
                "Train and track",
                "Evaluate against baseline",
                "Decide keep or discard",
                "Record results"
              ]
            }
          ],
          "methodTagging": "work-log entries may be tagged with a phase from getMethodForDiscipline"
        },
        {
          "key": "model_deployment",
          "title": "Model deployment",
          "frequency": "as_needed",
          "phasesFrom": "custom",
          "phases": [
            {
              "name": "Steps",
              "steps": [
                "Check evaluation and approval",
                "Package and version",
                "Deploy to staging",
                "Shadow or canary test",
                "Promote and monitor",
                "Keep rollback ready"
              ]
            }
          ],
          "methodTagging": "work-log entries may be tagged with a phase from getMethodForDiscipline"
        },
        {
          "key": "drift_and_bias_review",
          "title": "Drift and bias review",
          "frequency": "monthly",
          "phasesFrom": "custom",
          "phases": [
            {
              "name": "Steps",
              "steps": [
                "Collect production metrics",
                "Compare to baseline",
                "Check subgroup performance",
                "Decide on retraining",
                "Record findings"
              ]
            }
          ],
          "methodTagging": "work-log entries may be tagged with a phase from getMethodForDiscipline"
        },
        {
          "key": "model_retirement",
          "title": "Model retirement",
          "frequency": "as_needed",
          "phasesFrom": "custom",
          "phases": [
            {
              "name": "Steps",
              "steps": [
                "Confirm the replacement",
                "Notify users",
                "Archive artefacts and documentation",
                "Remove access",
                "Record"
              ]
            }
          ],
          "methodTagging": "work-log entries may be tagged with a phase from getMethodForDiscipline"
        },
        {
          "key": "escalation",
          "title": "Escalation",
          "frequency": "as_needed",
          "phasesFrom": "custom",
          "triggers": [
            "Model causing harm or unfair outcomes",
            "Sudden performance drop",
            "Training data issue or leakage",
            "Personal data in a training set",
            "Production rollback needed"
          ],
          "recordFields": [
            "date_time",
            "affected_area_or_system",
            "people_affected_by_code_or_count",
            "description",
            "actions_taken",
            "evidence_or_logs",
            "impact",
            "person_or_party_contacted",
            "current_status"
          ],
          "rules": [
            "Record facts; escalate promptly when a trigger is met"
          ]
        },
        {
          "key": "role_handover",
          "title": "Role handover",
          "frequency": "as_needed",
          "phasesFrom": "custom",
          "phases": [
            {
              "name": "Handover",
              "steps": [
                "Transfer Code repositories: model code",
                "Transfer Technical debt: model and data debt",
                "Transfer Pull requests: model changes",
                "Transfer Sprint backlog: ML work",
                "List open work, deadlines and commitments",
                "Share trackers, templates and contacts",
                "Transfer accounts and access only through the approved secure process, never in documents",
                "Brief the successor and confirm access",
                "Review progress after one week"
              ]
            }
          ]
        }
      ]
    },
