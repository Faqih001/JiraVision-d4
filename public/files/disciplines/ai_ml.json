{
  "schemaVersion": 1,
  "discipline": {
    "key": "ai_ml",
    "label": "AI and ML engineer",
    "category": "technology",
    "categoryLabel": "Software, IT & digital",
    "focus": "Experiments, deployments and responsible-AI review"
  },
  "pack": {
    "key": "developer",
    "reportTemplate": "engineering",
    "registerKinds": [
      "Code repositories",
      "Pull requests",
      "Technical debt",
      "Sprint backlog"
    ],
    "ladderDiscipline": {
      "proposed": "developer",
      "verifyIn": "lib/auto-populate.ts"
    }
  },
  "provenance": {
    "type": "proposed-seed",
    "sourceDocument": null,
    "reviewRequired": true,
    "reviewerRole": "experienced ai and ml engineer practitioner",
    "note": "Starting seed written without a source document. Not professional, clinical, legal, financial or safety advice. A practitioner must review before use.",
    "detailLevel": "detailed"
  },
  "method": {
    "resolveAtRuntime": "getMethodForDiscipline(pack, discipline)",
    "documentedSequence": [
      "Research",
      "Collect",
      "Train",
      "Validate",
      "Deploy",
      "Monitor"
    ],
    "documentedIn": "roles doc section 4.7 (verify in code)"
  },
  "surfaces": {
    "overview": {
      "path": "/dashboard/ops",
      "kpis": [
        {
          "id": "experiments_run",
          "label": "Experiments run",
          "source": "experiments",
          "sourceType": "log",
          "aggregation": "count",
          "defaultTarget": null,
          "computedBy": "code"
        },
        {
          "id": "deployments_successful",
          "label": "Deployments successful",
          "source": "model_deployments",
          "sourceType": "log",
          "aggregation": "rate",
          "defaultTarget": null,
          "computedBy": "code"
        },
        {
          "id": "rollbacks",
          "label": "Rollbacks",
          "source": "model_deployments",
          "sourceType": "log",
          "aggregation": "count",
          "defaultTarget": null,
          "computedBy": "code"
        },
        {
          "id": "debt_items",
          "label": "Debt items",
          "source": "technical_debt",
          "sourceType": "register",
          "aggregation": "count",
          "defaultTarget": null,
          "computedBy": "code"
        }
      ],
      "recommendRules": [
        {
          "id": "model_in_production_not_reviewed_in_30_days",
          "when": "model in production not reviewed in 30 days",
          "suggest": "review drift",
          "deterministic": true
        },
        {
          "id": "deployment_rolled_back",
          "when": "deployment rolled back",
          "suggest": "post-mortem",
          "deterministic": true
        }
      ]
    },
    "logs": {
      "path": "/dashboard/ops/logs",
      "entities": [
        {
          "key": "experiments",
          "label": "Experiments",
          "fields": [
            {
              "key": "run_date",
              "type": "date"
            },
            {
              "key": "model",
              "type": "text"
            },
            {
              "key": "dataset_version",
              "type": "text"
            },
            {
              "key": "metric",
              "type": "text"
            },
            {
              "key": "value",
              "type": "number"
            },
            {
              "key": "decision",
              "type": "enum",
              "values": [
                "keep",
                "discard"
              ]
            }
          ]
        },
        {
          "key": "model_deployments",
          "label": "Model deployments",
          "fields": [
            {
              "key": "deploy_date",
              "type": "date"
            },
            {
              "key": "model_version",
              "type": "text"
            },
            {
              "key": "environment",
              "type": "enum",
              "values": [
                "staging",
                "production"
              ]
            },
            {
              "key": "result",
              "type": "enum",
              "values": [
                "success",
                "rolled_back"
              ]
            }
          ]
        },
        {
          "key": "daily_checklist",
          "label": "Daily checklist",
          "fields": [
            {
              "key": "date",
              "type": "date"
            },
            {
              "key": "completed_by",
              "type": "text"
            },
            {
              "key": "check_training_and_inference_job_status",
              "type": "enum",
              "values": [
                "yes",
                "no",
                "n_a"
              ],
              "label": "Check training and inference job status"
            },
            {
              "key": "review_model_monitoring_metrics",
              "type": "enum",
              "values": [
                "yes",
                "no",
                "n_a"
              ],
              "label": "Review model monitoring metrics"
            },
            {
              "key": "check_data_pipeline_inputs",
              "type": "enum",
              "values": [
                "yes",
                "no",
                "n_a"
              ],
              "label": "Check data pipeline inputs"
            },
            {
              "key": "log_experiments_and_results",
              "type": "enum",
              "values": [
                "yes",
                "no",
                "n_a"
              ],
              "label": "Log experiments and results"
            },
            {
              "key": "review_model_related_tickets",
              "type": "enum",
              "values": [
                "yes",
                "no",
                "n_a"
              ],
              "label": "Review model-related tickets"
            },
            {
              "key": "check_compute_usage",
              "type": "enum",
              "values": [
                "yes",
                "no",
                "n_a"
              ],
              "label": "Check compute usage"
            }
          ]
        },
        {
          "key": "weekly_checklist",
          "label": "Weekly checklist",
          "fields": [
            {
              "key": "week_starting",
              "type": "date"
            },
            {
              "key": "completed_by",
              "type": "text"
            },
            {
              "key": "experiment_review",
              "type": "enum",
              "values": [
                "yes",
                "no",
                "n_a"
              ],
              "label": "Experiment review"
            },
            {
              "key": "model_performance_and_drift_review",
              "type": "enum",
              "values": [
                "yes",
                "no",
                "n_a"
              ],
              "label": "Model performance and drift review"
            },
            {
              "key": "dataset_and_label_quality_check",
              "type": "enum",
              "values": [
                "yes",
                "no",
                "n_a"
              ],
              "label": "Dataset and label quality check"
            },
            {
              "key": "review_errors_and_bias_samples",
              "type": "enum",
              "values": [
                "yes",
                "no",
                "n_a"
              ],
              "label": "Review errors and bias samples"
            },
            {
              "key": "update_experiment_tracking",
              "type": "enum",
              "values": [
                "yes",
                "no",
                "n_a"
              ],
              "label": "Update experiment tracking"
            }
          ]
        }
      ]
    },
    "registers": {
      "path": "/dashboard/registers",
      "items": [
        {
          "kind": "Code repositories",
          "track": [
            "model code"
          ]
        },
        {
          "kind": "Technical debt",
          "track": [
            "model and data debt"
          ]
        },
        {
          "kind": "Pull requests",
          "track": [
            "model changes"
          ]
        },
        {
          "kind": "Sprint backlog",
          "track": [
            "ML work"
          ]
        }
      ],
