{
  "schemaVersion": 1,
  "discipline": {
    "key": "data_analyst",
    "label": "Data analyst",
    "category": "information",
    "categoryLabel": "Analysis, research & information",
    "focus": "Dashboards, refreshes and data quality"
  },
  "pack": {
    "key": "analyst",
    "reportTemplate": "assurance",
    "registerKinds": [
      "Data sources",
      "Analysis reports",
      "Dashboards",
      "Methodology"
    ],
    "ladderDiscipline": {
      "proposed": "analyst",
      "verifyIn": "lib/auto-populate.ts"
    }
  },
  "provenance": {
    "type": "proposed-seed",
    "sourceDocument": null,
    "reviewRequired": true,
    "reviewerRole": "experienced data analyst practitioner",
    "note": "Starting seed written without a source document. Not professional, clinical, legal, financial or safety advice. A practitioner must review before use.",
    "detailLevel": "detailed"
  },
  "method": {
    "resolveAtRuntime": "getMethodForDiscipline(pack, discipline)",
    "documentedSequence": null,
    "documentedIn": null
  },
  "surfaces": {
    "overview": {
      "path": "/dashboard/ops",
      "kpis": [
        {
          "id": "refresh_success_rate",
          "label": "Refresh success rate",
          "source": "data_refreshes",
          "sourceType": "log",
          "aggregation": "rate",
          "defaultTarget": null,
          "computedBy": "code"
        },
        {
          "id": "open_data_quality_issues",
          "label": "Open data quality issues",
          "source": "data_quality_issues",
          "sourceType": "log",
          "aggregation": "open_count",
          "defaultTarget": null,
          "computedBy": "code"
        },
        {
          "id": "dashboards",
          "label": "Dashboards",
          "source": "dashboards",
          "sourceType": "register",
          "aggregation": "count",
          "defaultTarget": null,
          "computedBy": "code"
        },
        {
          "id": "issues_fixed",
          "label": "Issues fixed",
          "source": "data_quality_issues",
          "sourceType": "log",
          "aggregation": "count",
          "defaultTarget": null,
          "computedBy": "code"
        }
      ],
      "recommendRules": [
        {
          "id": "refresh_failed_twice",
          "when": "refresh failed twice",
          "suggest": "investigate source",
          "deterministic": true
        },
        {
          "id": "issue_open_over_7_days",
          "when": "issue open over 7 days",
          "suggest": "assign owner",
          "deterministic": true
        }
      ]
    },
    "logs": {
      "path": "/dashboard/ops/logs",
      "entities": [
        {
          "key": "data_refreshes",
          "label": "Data refreshes",
          "fields": [
            {
              "key": "refresh_date",
              "type": "date"
            },
            {
              "key": "source",
              "type": "text"
            },
            {
              "key": "dashboard",
              "type": "text"
            },
            {
              "key": "result",
              "type": "enum",
              "values": [
                "success",
                "failed"
              ]
            }
          ]
        },
        {
          "key": "data_quality_issues",
          "label": "Data quality issues",
          "fields": [
            {
              "key": "found_date",
              "type": "date"
            },
            {
              "key": "dataset",
              "type": "text"
            },
            {
              "key": "issue",
              "type": "text"
            },
            {
              "key": "status",
              "type": "enum",
              "values": [
                "open",
                "fixed"
              ]
            }
          ]
        },
        {
          "key": "daily_checklist",
          "label": "Daily checklist",
          "fields": [
            {
              "key": "date",
              "type": "date"
            },
            {
              "key": "completed_by",
              "type": "text"
            },
            {
              "key": "check_data_refresh_results",
              "type": "enum",
              "values": [
                "yes",
                "no",
                "n_a"
              ],
              "label": "Check data refresh results"
            },
            {
              "key": "review_dashboard_anomalies",
              "type": "enum",
              "values": [
                "yes",
                "no",
                "n_a"
              ],
              "label": "Review dashboard anomalies"
            },
            {
              "key": "answer_ad_hoc_data_questions",
              "type": "enum",
              "values": [
                "yes",
                "no",
                "n_a"
              ],
              "label": "Answer ad hoc data questions"
            },
            {
              "key": "check_data_quality_alerts",
              "type": "enum",
              "values": [
                "yes",
                "no",
                "n_a"
              ],
              "label": "Check data quality alerts"
            },
            {
              "key": "update_ticket_status",
              "type": "enum",
              "values": [
                "yes",
                "no",
                "n_a"
              ],
              "label": "Update ticket status"
            }
          ]
        },
        {
          "key": "weekly_checklist",
          "label": "Weekly checklist",
          "fields": [
            {
              "key": "week_starting",
              "type": "date"
            },
            {
              "key": "completed_by",
              "type": "text"
            },
            {
              "key": "data_quality_review",
              "type": "enum",
              "values": [
                "yes",
                "no",
                "n_a"
              ],
              "label": "Data quality review"
            },
            {
              "key": "dashboard_accuracy_review",
              "type": "enum",
              "values": [
                "yes",
                "no",
                "n_a"
              ],
              "label": "Dashboard accuracy review"
            },
            {
              "key": "stakeholder_report_delivery",
              "type": "enum",
              "values": [
                "yes",
                "no",
                "n_a"
              ],
              "label": "Stakeholder report delivery"
            },
            {
              "key": "review_usage_of_dashboards",
              "type": "enum",
              "values": [
                "yes",
                "no",
                "n_a"
              ],
              "label": "Review usage of dashboards"
            },
            {
              "key": "document_changes",
              "type": "enum",
              "values": [
                "yes",
                "no",
                "n_a"
              ],
              "label": "Document changes"
            }
          ]
        }
      ]
    },
