    "playbooks": {
      "path": "/dashboard/playbooks",
      "seeds": [
        {
          "key": "daily_refresh_check",
          "title": "Daily refresh check",
          "frequency": "daily",
          "phasesFrom": "custom",
          "phases": [
            {
              "name": "Steps",
              "steps": [
                "List scheduled refreshes",
                "Confirm success and timing",
                "Investigate failures",
                "Notify users if data is late",
                "Record the outcome"
              ]
            }
          ],
          "methodTagging": "work-log entries may be tagged with a phase from getMethodForDiscipline"
        },
        {
          "key": "data_quality_investigation",
          "title": "Data quality investigation",
          "frequency": "as_needed",
          "phasesFrom": "custom",
          "phases": [
            {
              "name": "Steps",
              "steps": [
                "Describe the anomaly",
                "Trace to source",
                "Test with queries",
                "Fix or report to the owner",
                "Record the resolution"
              ]
            }
          ],
          "methodTagging": "work-log entries may be tagged with a phase from getMethodForDiscipline"
        },
        {
          "key": "new_dashboard",
          "title": "New dashboard",
          "frequency": "as_needed",
          "phasesFrom": "custom",
          "phases": [
            {
              "name": "Steps",
              "steps": [
                "Agree purpose and audience",
                "Define metrics",
                "Build and test",
                "Review with users",
                "Publish and document"
              ]
            }
          ],
          "methodTagging": "work-log entries may be tagged with a phase from getMethodForDiscipline"
        },
        {
          "key": "metric_definition_change",
          "title": "Metric definition change",
          "frequency": "as_needed",
          "phasesFrom": "custom",
          "phases": [
            {
              "name": "Steps",
              "steps": [
                "Describe the change and reason",
                "Assess impact on history",
                "Get approval",
                "Update and announce",
                "Record the version"
              ]
            }
          ],
          "methodTagging": "work-log entries may be tagged with a phase from getMethodForDiscipline"
        },
        {
          "key": "escalation",
          "title": "Escalation",
          "frequency": "as_needed",
          "phasesFrom": "custom",
          "triggers": [
            "Executive dashboard shows wrong data",
            "Refresh failing over a day",
            "Source system change",
            "Sensitive data exposure",
            "Conflicting metric definitions"
          ],
          "recordFields": [
            "date_time",
            "affected_area_or_system",
            "people_affected_by_code_or_count",
            "description",
            "actions_taken",
            "evidence_or_logs",
            "impact",
            "person_or_party_contacted",
            "current_status"
          ],
          "rules": [
            "Record facts; escalate promptly when a trigger is met"
          ]
        },
        {
          "key": "role_handover",
          "title": "Role handover",
          "frequency": "as_needed",
          "phasesFrom": "custom",
          "phases": [
            {
              "name": "Handover",
              "steps": [
                "Transfer Data sources: source systems",
                "Transfer Dashboards: dashboards owned",
                "Transfer Analysis reports: recurring reports",
                "List open work, deadlines and commitments",
                "Share trackers, templates and contacts",
                "Transfer accounts and access only through the approved secure process, never in documents",
                "Brief the successor and confirm access",
                "Review progress after one week"
              ]
            }
          ]
        }
      ]
    },
