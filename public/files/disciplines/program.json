    "playbooks": {
      "path": "/dashboard/playbooks",
      "seeds": [
        {
          "key": "programme_status_review",
          "title": "Programme status review",
          "frequency": "weekly",
          "phasesFrom": "custom",
          "phases": [
            {
              "name": "Steps",
              "steps": [
                "Collect status from each project",
                "Check milestones against plan",
                "Review dependencies and blockers",
                "Review risks and issues",
                "Agree actions and publish the report"
              ]
            }
          ],
          "methodTagging": "work-log entries may be tagged with a phase from getMethodForDiscipline"
        },
        {
          "key": "dependency_management",
          "title": "Dependency management",
          "frequency": "weekly",
          "phasesFrom": "custom",
          "phases": [
            {
              "name": "Steps",
              "steps": [
                "List dependencies by project",
                "Confirm owners and dates",
                "Flag blocked items",
                "Escalate unresolved dependencies",
                "Update the tracker"
              ]
            }
          ],
          "methodTagging": "work-log entries may be tagged with a phase from getMethodForDiscipline"
        },
        {
          "key": "stage_gate",
          "title": "Stage gate",
          "frequency": "quarterly",
          "phasesFrom": "custom",
          "phases": [
            {
              "name": "Steps",
              "steps": [
                "Check entry criteria are met",
                "Review deliverables and benefits",
                "Assess risks and budget",
                "Take a go, hold or stop decision",
                "Record and communicate"
              ]
            }
          ],
          "methodTagging": "work-log entries may be tagged with a phase from getMethodForDiscipline"
        },
        {
          "key": "programme_closure",
          "title": "Programme closure",
          "frequency": "as_needed",
          "phasesFrom": "custom",
          "phases": [
            {
              "name": "Steps",
              "steps": [
                "Confirm all deliverables are accepted",
                "Transfer to operations",
                "Release resources",
                "Review benefits and lessons",
                "Archive records"
              ]
            }
          ],
          "methodTagging": "work-log entries may be tagged with a phase from getMethodForDiscipline"
        },
        {
          "key": "escalation",
          "title": "Escalation",
          "frequency": "as_needed",
          "phasesFrom": "custom",
          "triggers": [
            "Critical path milestone at risk",
            "Cross-project conflict unresolved",
            "Budget variance above tolerance",
            "Key supplier failure",
            "Benefit case no longer valid"
          ],
          "recordFields": [
            "date_time",
            "affected_area_or_system",
            "people_affected_by_code_or_count",
            "description",
            "actions_taken",
            "evidence_or_logs",
            "impact",
            "person_or_party_contacted",
            "current_status"
          ],
          "rules": [
            "Record facts; escalate promptly when a trigger is met"
          ]
        },
        {
          "key": "role_handover",
          "title": "Role handover",
          "frequency": "as_needed",
          "phasesFrom": "custom",
          "phases": [
            {
              "name": "Handover",
              "steps": [
                "Transfer Initiatives: projects in the programme",
                "Transfer Risks: programme risks and dependencies",
                "Transfer Reports: status reports",
                "List open work, deadlines and commitments",
                "Share trackers, templates and contacts",
                "Transfer accounts and access only through the approved secure process, never in documents",
                "Brief the successor and confirm access",
                "Review progress after one week"
              ]
            }
          ]
        }
      ]
