{
  "schemaVersion": 1,
  "discipline": {
    "key": "program",
    "label": "Programme",
    "category": "delivery",
    "categoryLabel": "Management & project delivery",
    "focus": "Cross-project programme governance"
  },
  "pack": {
    "key": "management",
    "reportTemplate": "general",
    "registerKinds": [
      "Initiatives",
      "Stakeholders",
      "Risks",
      "Reports"
    ],
    "ladderDiscipline": {
      "proposed": "coordinator",
      "verifyIn": "lib/auto-populate.ts"
    }
  },
  "provenance": {
    "type": "proposed-seed",
    "sourceDocument": null,
    "reviewRequired": true,
    "reviewerRole": "experienced programme practitioner",
    "note": "Starting seed written without a source document. Not professional, clinical, legal, financial or safety advice. A practitioner must review before use.",
    "detailLevel": "detailed"
  },
  "method": {
    "resolveAtRuntime": "getMethodForDiscipline(pack, discipline)",
    "documentedSequence": null,
    "documentedIn": null
  },
  "surfaces": {
    "overview": {
      "path": "/dashboard/ops",
      "kpis": [
        {
          "id": "milestones_hit",
          "label": "Milestones hit",
          "source": "milestones",
          "sourceType": "log",
          "aggregation": "count",
          "defaultTarget": null,
          "computedBy": "code"
        },
        {
          "id": "blocked_dependencies",
          "label": "Blocked dependencies",
          "source": "dependencies",
          "sourceType": "log",
          "aggregation": "open_count",
          "defaultTarget": null,
          "computedBy": "code"
        },
        {
          "id": "programme_risks_rated_high",
          "label": "Programme risks rated high",
          "source": "risks",
          "sourceType": "register",
          "aggregation": "count",
          "defaultTarget": null,
          "computedBy": "code"
        },
        {
          "id": "status_reports_delivered",
          "label": "Status reports delivered",
          "source": "reports",
          "sourceType": "register",
          "aggregation": "count",
          "defaultTarget": null,
          "computedBy": "code"
        }
      ],
      "recommendRules": [
        {
          "id": "dependency_blocked_over_5_days",
          "when": "dependency blocked over 5 days",
          "suggest": "escalate",
          "deterministic": true
        },
        {
          "id": "milestone_missed",
          "when": "milestone missed",
          "suggest": "replan",
          "deterministic": true
        }
      ]
    },
