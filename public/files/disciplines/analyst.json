    "registers": {
      "path": "/dashboard/registers",
      "items": [
        {
          "kind": "Data sources",
          "track": [
            "sources and owners"
          ]
        },
        {
          "kind": "Analysis reports",
          "track": [
            "delivered analyses"
          ]
        },
        {
          "kind": "Dashboards",
