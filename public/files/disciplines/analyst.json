{
  "schemaVersion": 1,
  "discipline": {
    "key": "analyst",
    "label": "Analyst",
    "category": "information",
    "categoryLabel": "Analysis, research & information",
    "focus": "Analysis requests, reports and methodology"
  },
  "pack": {
    "key": "analyst",
    "reportTemplate": "assurance",
    "registerKinds": [
      "Data sources",
      "Analysis reports",
      "Dashboards",
      "Methodology"
    ],
    "ladderDiscipline": {
      "proposed": "analyst",
      "verifyIn": "lib/auto-populate.ts"
    }
  },
  "provenance": {
    "type": "proposed-seed",
    "sourceDocument": null,
    "reviewRequired": true,
    "reviewerRole": "experienced analyst practitioner",
    "note": "Starting seed written without a source document. Not professional, clinical, legal, financial or safety advice. A practitioner must review before use.",
    "detailLevel": "detailed"
  },
  "method": {
    "resolveAtRuntime": "getMethodForDiscipline(pack, discipline)",
    "documentedSequence": null,
    "documentedIn": null
  },
  "surfaces": {
    "overview": {
      "path": "/dashboard/ops",
      "kpis": [
        {
          "id": "requests_delivered",
          "label": "Requests delivered",
          "source": "analysis_requests",
          "sourceType": "log",
          "aggregation": "count",
          "defaultTarget": null,
          "computedBy": "code"
        },
        {
          "id": "requests_overdue",
          "label": "Requests overdue",
          "source": "analysis_requests",
          "sourceType": "log",
          "aggregation": "overdue_count",
          "defaultTarget": null,
          "computedBy": "code"
        },
        {
          "id": "reports_approved_first_time",
          "label": "Reports approved first time",
          "source": "report_reviews",
          "sourceType": "log",
          "aggregation": "count",
          "defaultTarget": null,
          "computedBy": "code"
        },
        {
          "id": "data_sources_documented",
          "label": "Data sources documented",
          "source": "data_sources",
          "sourceType": "register",
          "aggregation": "count",
          "defaultTarget": null,
          "computedBy": "code"
        }
      ],
      "recommendRules": [
        {
          "id": "request_past_due",
          "when": "request past due",
          "suggest": "update requester",
          "deterministic": true
        },
        {
          "id": "source_not_reviewed_in_90_days",
          "when": "source not reviewed in 90 days",
          "suggest": "verify",
          "deterministic": true
        }
      ]
    },
    "logs": {
      "path": "/dashboard/ops/logs",
      "entities": [
        {
          "key": "analysis_requests",
          "label": "Analysis requests",
          "fields": [
            {
              "key": "received_date",
              "type": "date"
            },
            {
              "key": "requester",
              "type": "text"
            },
            {
              "key": "question",
              "type": "text"
            },
            {
              "key": "due_date",
              "type": "date"
            },
            {
              "key": "status",
              "type": "enum",
              "values": [
                "requested",
                "in_progress",
                "delivered"
              ]
            }
          ]
        },
        {
          "key": "report_reviews",
          "label": "Report reviews",
          "fields": [
            {
              "key": "review_date",
              "type": "date"
            },
            {
              "key": "report",
              "type": "text"
            },
            {
              "key": "reviewer_ref",
              "type": "text"
            },
            {
              "key": "outcome",
              "type": "enum",
              "values": [
                "approved",
                "changes"
              ]
            }
          ]
        },
        {
          "key": "daily_checklist",
          "label": "Daily checklist",
          "fields": [
            {
              "key": "date",
              "type": "date"
            },
            {
              "key": "completed_by",
              "type": "text"
            },
            {
              "key": "triage_new_analysis_requests",
              "type": "enum",
              "values": [
                "yes",
                "no",
                "n_a"
              ],
              "label": "Triage new analysis requests"
            },
            {
              "key": "work_planned_analyses_and_queries",
              "type": "enum",
              "values": [
                "yes",
                "no",
                "n_a"
              ],
              "label": "Work planned analyses and queries"
            },
            {
              "key": "check_dashboard_and_data_refresh_status",
              "type": "enum",
              "values": [
                "yes",
                "no",
                "n_a"
              ],
              "label": "Check dashboard and data refresh status"
            },
            {
              "key": "answer_stakeholder_questions",
              "type": "enum",
              "values": [
                "yes",
                "no",
                "n_a"
              ],
              "label": "Answer stakeholder questions"
            },
            {
              "key": "update_the_request_tracker",
              "type": "enum",
              "values": [
                "yes",
                "no",
                "n_a"
              ],
              "label": "Update the request tracker"
            }
          ]
        },
        {
          "key": "weekly_checklist",
          "label": "Weekly checklist",
          "fields": [
            {
              "key": "week_starting",
              "type": "date"
            },
            {
              "key": "completed_by",
              "type": "text"
            },
            {
              "key": "report_and_analysis_review_with_a_peer",
              "type": "enum",
              "values": [
                "yes",
                "no",
                "n_a"
              ],
              "label": "Report and analysis review with a peer"
            },
            {
              "key": "data_source_and_quality_check",
              "type": "enum",
              "values": [
                "yes",
                "no",
                "n_a"
              ],
              "label": "Data source and quality check"
            },
            {
              "key": "stakeholder_update",
              "type": "enum",
              "values": [
                "yes",
                "no",
                "n_a"
              ],
              "label": "Stakeholder update"
            },
            {
              "key": "refine_or_retire_dashboards",
              "type": "enum",
              "values": [
                "yes",
                "no",
                "n_a"
              ],
              "label": "Refine or retire dashboards"
            },
            {
              "key": "update_methodology_notes",
              "type": "enum",
              "values": [
                "yes",
                "no",
                "n_a"
              ],
              "label": "Update methodology notes"
            }
          ]
        }
      ]
