        "Peer review notes"
      ]
    },
    "playbooks": {
      "path": "/dashboard/playbooks",
      "seeds": [
        {
          "key": "analysis_request",
          "title": "Analysis request",
          "frequency": "as_needed",
          "phasesFrom": "custom",
          "phases": [
            {
              "name": "Steps",
              "steps": [
                "Clarify the question and the decision it supports",
                "Agree scope, data and deadline",
                "Get and check data",
                "Analyse and test assumptions",
                "Peer review",
                "Deliver with caveats and next steps"
              ]
            }
          ],
          "methodTagging": "work-log entries may be tagged with a phase from getMethodForDiscipline"
        },
        {
          "key": "report_review",
          "title": "Report review",
          "frequency": "weekly",
          "phasesFrom": "custom",
          "phases": [
            {
              "name": "Steps",
              "steps": [
                "Check the question is answered",
                "Check numbers against source",
                "Check method and assumptions",
                "Check charts and wording",
                "Approve or request changes"
              ]
            }
          ],
          "methodTagging": "work-log entries may be tagged with a phase from getMethodForDiscipline"
        },
        {
          "key": "data_source_documentation",
          "title": "Data source documentation",
          "frequency": "monthly",
          "phasesFrom": "custom",
          "phases": [
            {
              "name": "Steps",
              "steps": [
                "List fields and definitions",
                "Record owner and refresh frequency",
                "Note known issues",
                "Link to dashboards",
                "Review annually"
              ]
            }
          ],
          "methodTagging": "work-log entries may be tagged with a phase from getMethodForDiscipline"
        },
        {
          "key": "dashboard_handover",
          "title": "Dashboard handover",
          "frequency": "as_needed",
          "phasesFrom": "custom",
          "phases": [
            {
              "name": "Steps",
              "steps": [
                "Document purpose and audience",
                "Document data and logic",
                "Give access and training",
                "Agree support",
                "Record"
              ]
            }
          ],
          "methodTagging": "work-log entries may be tagged with a phase from getMethodForDiscipline"
        },
        {
          "key": "escalation",
          "title": "Escalation",
          "frequency": "as_needed",
          "phasesFrom": "custom",
          "triggers": [
            "Figures conflict between sources",
            "Data error found in a published report",
            "Sensitive data exposed",
            "Request conflicts with data policy",
            "Deadline cannot be met"
          ],
          "recordFields": [
            "date_time",
            "affected_area_or_system",
            "people_affected_by_code_or_count",
            "description",
            "actions_taken",
            "evidence_or_logs",
            "impact",
            "person_or_party_contacted",
            "current_status"
          ],
          "rules": [
            "Record facts; escalate promptly when a trigger is met"
          ]
        },
        {
          "key": "role_handover",
          "title": "Role handover",
          "frequency": "as_needed",
          "phasesFrom": "custom",
          "phases": [
            {
              "name": "Handover",
              "steps": [
                "Transfer Data sources: sources and owners",
                "Transfer Analysis reports: delivered analyses",
                "Transfer Dashboards: dashboards maintained",
                "Transfer Methodology: approaches used",
                "List open work, deadlines and commitments",
                "Share trackers, templates and contacts",
                "Transfer accounts and access only through the approved secure process, never in documents",
                "Brief the successor and confirm access",
                "Review progress after one week"
              ]
            }
          ]
        }
      ]
    },
