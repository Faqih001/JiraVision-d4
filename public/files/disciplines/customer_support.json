  "surfaces": {
    "overview": {
      "path": "/dashboard/ops",
      "kpis": [
        {
          "id": "tickets_resolved",
          "label": "Tickets resolved",
          "source": "support_tickets",
          "sourceType": "log",
          "aggregation": "count",
          "defaultTarget": null,
          "computedBy": "code"
        },
        {
          "id": "open_tickets",
          "label": "Open tickets",
          "source": "support_tickets",
          "sourceType": "log",
          "aggregation": "open_count",
          "defaultTarget": null,
          "computedBy": "code"
        },
        {
          "id": "average_satisfaction",
          "label": "Average satisfaction",
          "source": "csat_responses",
          "sourceType": "log",
          "aggregation": "avg",
          "defaultTarget": null,
          "computedBy": "code"
        },
        {
          "id": "tickets_past_response_target",
          "label": "Tickets past response target",
          "source": "support_tickets",
          "sourceType": "log",
          "aggregation": "overdue_count",
          "defaultTarget": null,
          "computedBy": "code"
        }
      ],
      "recommendRules": [
        {
          "id": "urgent_ticket_unanswered_1_hour",
          "when": "urgent ticket unanswered 1 hour",
          "suggest": "escalate",
          "deterministic": true
        },
        {
          "id": "repeat_issue_from_same_customer",
          "when": "repeat issue from same customer",
          "suggest": "root cause",
          "deterministic": true
        }
      ]
    },
