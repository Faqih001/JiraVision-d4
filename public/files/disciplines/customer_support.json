    "playbooks": {
      "path": "/dashboard/playbooks",
      "seeds": [
        {
          "key": "ticket_handling",
          "title": "Ticket handling",
          "frequency": "daily",
          "phasesFrom": "custom",
          "phases": [
            {
              "name": "Steps",
              "steps": [
                "Read and confirm the issue",
                "Check history and the knowledge base",
                "Fix or give a workaround",
                "Reply clearly",
                "Confirm resolution",
                "Close and tag"
              ]
            }
          ],
          "methodTagging": "work-log entries may be tagged with a phase from getMethodForDiscipline"
        },
        {
          "key": "escalation_to_engineering",
          "title": "Escalation to engineering",
          "frequency": "as_needed",
          "phasesFrom": "custom",
          "phases": [
            {
              "name": "Steps",
              "steps": [
                "Reproduce and gather evidence",
                "Add logs and customer impact",
                "Set severity",
                "Hand over with context",
                "Update the customer"
              ]
            }
          ],
          "methodTagging": "work-log entries may be tagged with a phase from getMethodForDiscipline"
        },
        {
          "key": "quality_review",
          "title": "Quality review",
          "frequency": "weekly",
          "phasesFrom": "custom",
          "phases": [
            {
              "name": "Steps",
              "steps": [
                "Sample tickets",
                "Score accuracy, tone and speed",
                "Give feedback",
                "Share good examples",
                "Record"
              ]
            }
          ],
          "methodTagging": "work-log entries may be tagged with a phase from getMethodForDiscipline"
        },
        {
          "key": "major_incident_communication",
          "title": "Major incident communication",
          "frequency": "as_needed",
          "phasesFrom": "custom",
          "phases": [
            {
              "name": "Steps",
              "steps": [
                "Confirm scope",
                "Post a status update",
                "Update at set intervals",
                "Notify affected customers",
                "Follow up with a summary"
              ]
            }
          ],
          "methodTagging": "work-log entries may be tagged with a phase from getMethodForDiscipline"
        },
        {
          "key": "escalation",
          "title": "Escalation",
          "frequency": "as_needed",
          "phasesFrom": "custom",
          "triggers": [
            "Urgent ticket unanswered",
            "Data breach or privacy complaint",
            "Many customers affected by one issue",
            "Abusive or threatening contact",
            "Complaint to a regulator or the media"
          ],
          "recordFields": [
            "date_time",
            "affected_area_or_system",
            "people_affected_by_code_or_count",
            "description",
            "actions_taken",
            "evidence_or_logs",
            "impact",
            "person_or_party_contacted",
            "current_status"
          ],
          "rules": [
            "Record facts only; no personal identifiers in free text"
          ]
        },
        {
          "key": "role_handover",
          "title": "Role handover",
          "frequency": "as_needed",
          "phasesFrom": "custom",
          "phases": [
            {
              "name": "Handover",
              "steps": [
                "Transfer Leads: escalations",
                "Transfer Campaigns: support campaigns",
                "Transfer Customers: accounts",
                "Transfer Metrics: support metrics",
                "List open work, deadlines and commitments",
                "Share trackers, templates and contacts",
                "Transfer accounts and access only through the approved secure process, never in documents",
                "Brief the successor and confirm access",
                "Review progress after one week"
              ]
            }
          ]
        }
