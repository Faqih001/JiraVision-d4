        "Environment inventory",
        "Deployment log",
        "Runbooks",
        "Cost reports"
      ]
    },
    "playbooks": {
      "path": "/dashboard/playbooks",
      "seeds": [
        {
          "key": "pipeline_health_check",
          "title": "Pipeline health check",
          "frequency": "daily",
          "phasesFrom": "custom",
          "phases": [
            {
              "name": "Steps",
              "steps": [
                "Review failures since the last check",
                "Group by cause",
                "Fix or quarantine flaky steps",
                "Notify owners",
                "Record fixes"
              ]
            }
          ],
          "methodTagging": "work-log entries may be tagged with a phase from getMethodForDiscipline"
        },
        {
          "key": "deployment",
          "title": "Deployment",
          "frequency": "weekly",
          "phasesFrom": "custom",
          "phases": [
            {
              "name": "Steps",
              "steps": [
                "Confirm the build passed and approvals",
                "Deploy to staging and verify",
                "Deploy to production with a safe strategy",
                "Watch metrics and logs",
                "Roll back if thresholds breach",
                "Record the deployment"
              ]
            }
          ],
          "methodTagging": "work-log entries may be tagged with a phase from getMethodForDiscipline"
        },
        {
          "key": "infrastructure_change",
          "title": "Infrastructure change",
          "frequency": "as_needed",
          "phasesFrom": "custom",
          "phases": [
            {
              "name": "Steps",
              "steps": [
                "Write the change in code",
                "Review and plan",
                "Apply to non-production",
                "Apply to production",
                "Verify and record"
              ]
            }
          ],
          "methodTagging": "work-log entries may be tagged with a phase from getMethodForDiscipline"
        },
        {
          "key": "secret_and_certificate_rotation",
          "title": "Secret and certificate rotation",
          "frequency": "monthly",
          "phasesFrom": "custom",
          "phases": [
            {
              "name": "Steps",
              "steps": [
                "List expiring items",
                "Rotate and update consumers",
                "Test connections",
                "Revoke old values",
                "Record the rotation"
              ]
            }
          ],
          "methodTagging": "work-log entries may be tagged with a phase from getMethodForDiscipline"
        },
        {
          "key": "escalation",
          "title": "Escalation",
          "frequency": "as_needed",
          "phasesFrom": "custom",
          "triggers": [
            "Production deployment failing",
            "Pipeline compromised or secret leaked",
            "Cloud cost spike",
            "Backup or snapshot failure",
            "Infrastructure drift in production"
          ],
          "recordFields": [
            "date_time",
            "affected_area_or_system",
            "people_affected_by_code_or_count",
            "description",
            "actions_taken",
            "evidence_or_logs",
            "impact",
            "person_or_party_contacted",
            "current_status"
          ],
          "rules": [
            "Record facts; escalate promptly when a trigger is met"
          ]
        },
        {
          "key": "role_handover",
          "title": "Role handover",
          "frequency": "as_needed",
          "phasesFrom": "custom",
          "phases": [
            {
              "name": "Handover",
              "steps": [
                "Transfer Infrastructure: environments",
                "Transfer Accounts and systems: CI/CD and cloud accounts (references only)",
                "Transfer Equipment: build agents",
                "Transfer Outstanding work: automation backlog",
                "List open work, deadlines and commitments",
                "Share trackers, templates and contacts",
                "Transfer accounts and access only through the approved secure process, never in documents",
                "Brief the successor and confirm access",
                "Review progress after one week"
              ]
            }
          ]
        }
      ]
    },
