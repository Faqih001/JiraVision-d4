{
  "schemaVersion": 1,
  "discipline": {
    "key": "devops",
    "label": "DevOps",
    "category": "technology",
    "categoryLabel": "Software, IT & digital",
    "focus": "Pipelines, deployments and infrastructure automation"
  },
  "pack": {
    "key": "it-technician",
    "reportTemplate": "technical",
    "registerKinds": [
      "Infrastructure",
      "Accounts and systems",
      "Equipment",
      "Outstanding work"
    ],
    "ladderDiscipline": {
      "proposed": "technician",
      "verifyIn": "lib/auto-populate.ts"
    }
  },
  "provenance": {
    "type": "proposed-seed",
    "sourceDocument": null,
    "reviewRequired": true,
    "reviewerRole": "experienced devops practitioner",
    "note": "Starting seed written without a source document. Not professional, clinical, legal, financial or safety advice. A practitioner must review before use.",
    "detailLevel": "detailed"
  },
  "method": {
    "resolveAtRuntime": "getMethodForDiscipline(pack, discipline)",
    "documentedSequence": [
      "Plan",
      "Automate",
      "Deploy",
      "Monitor",
      "Optimize",
      "Document"
    ],
    "documentedIn": "roles doc section 4.7 (verify in code)"
  },
  "surfaces": {
    "overview": {
      "path": "/dashboard/ops",
      "kpis": [
        {
          "id": "deployment_success_rate",
          "label": "Deployment success rate",
          "source": "deployments",
          "sourceType": "log",
          "aggregation": "rate",
          "defaultTarget": null,
          "computedBy": "code"
        },
        {
          "id": "rollbacks",
          "label": "Rollbacks",
          "source": "deployments",
          "sourceType": "log",
          "aggregation": "count",
          "defaultTarget": null,
          "computedBy": "code"
        },
        {
          "id": "pipeline_failures_open",
          "label": "Pipeline failures open",
          "source": "pipeline_failures",
          "sourceType": "log",
          "aggregation": "open_count",
          "defaultTarget": null,
          "computedBy": "code"
        },
        {
          "id": "environments_tracked",
          "label": "Environments tracked",
          "source": "infrastructure",
          "sourceType": "register",
          "aggregation": "count",
          "defaultTarget": null,
          "computedBy": "code"
        }
      ],
      "recommendRules": [
        {
          "id": "pipeline_failing_over_1_day",
          "when": "pipeline failing over 1 day",
          "suggest": "fix",
          "deterministic": true
        },
        {
          "id": "rollback",
          "when": "rollback",
          "suggest": "add to post-mortem",
          "deterministic": true
        }
      ]
    },
    "logs": {
      "path": "/dashboard/ops/logs",
      "entities": [
        {
          "key": "deployments",
          "label": "Deployments",
          "fields": [
            {
              "key": "deploy_date",
              "type": "date"
            },
            {
              "key": "service",
              "type": "text"
            },
            {
              "key": "environment",
              "type": "enum",
              "values": [
                "dev",
                "staging",
                "production"
              ]
            },
            {
              "key": "result",
              "type": "enum",
              "values": [
                "success",
                "failed"
              ]
            },
            {
              "key": "rollback",
              "type": "enum",
              "values": [
                "yes",
                "no"
              ]
            }
          ]
        },
        {
          "key": "pipeline_failures",
          "label": "Pipeline failures",
          "fields": [
            {
              "key": "failure_date",
              "type": "date"
            },
            {
              "key": "pipeline",
              "type": "text"
            },
            {
              "key": "cause",
              "type": "text"
            },
            {
              "key": "fixed_date",
              "type": "date"
            }
          ]
        },
        {
          "key": "daily_checklist",
          "label": "Daily checklist",
          "fields": [
            {
              "key": "date",
              "type": "date"
            },
            {
              "key": "completed_by",
              "type": "text"
            },
            {
              "key": "check_pipeline_and_deployment_status",
              "type": "enum",
              "values": [
                "yes",
                "no",
                "n_a"
              ],
              "label": "Check pipeline and deployment status"
            },
            {
              "key": "review_infrastructure_alerts",
              "type": "enum",
              "values": [
                "yes",
                "no",
                "n_a"
              ],
              "label": "Review infrastructure alerts"
            },
            {
              "key": "review_failed_jobs_and_flaky_tests",
              "type": "enum",
              "values": [
                "yes",
                "no",
                "n_a"
              ],
              "label": "Review failed jobs and flaky tests"
            },
            {
              "key": "check_cost_and_resource_anomalies",
              "type": "enum",
              "values": [
                "yes",
                "no",
                "n_a"
              ],
              "label": "Check cost and resource anomalies"
            },
            {
              "key": "respond_to_developer_requests",
              "type": "enum",
              "values": [
                "yes",
                "no",
                "n_a"
              ],
              "label": "Respond to developer requests"
            },
            {
              "key": "check_secret_and_certificate_expiry_alerts",
              "type": "enum",
              "values": [
                "yes",
                "no",
                "n_a"
              ],
              "label": "Check secret and certificate expiry alerts"
            }
          ]
        },
        {
          "key": "weekly_checklist",
          "label": "Weekly checklist",
          "fields": [
            {
              "key": "week_starting",
              "type": "date"
            },
            {
              "key": "completed_by",
              "type": "text"
            },
            {
              "key": "deployment_and_rollback_review",
              "type": "enum",
              "values": [
                "yes",
                "no",
                "n_a"
              ],
              "label": "Deployment and rollback review"
            },
            {
              "key": "infrastructure_as_code_review",
              "type": "enum",
              "values": [
                "yes",
                "no",
                "n_a"
              ],
              "label": "Infrastructure as code review"
            },
            {
              "key": "security_scan_results_review",
              "type": "enum",
              "values": [
                "yes",
                "no",
                "n_a"
              ],
              "label": "Security scan results review"
            },
            {
              "key": "backup_and_snapshot_verification",
              "type": "enum",
              "values": [
                "yes",
                "no",
                "n_a"
              ],
              "label": "Backup and snapshot verification"
            },
            {
              "key": "clean_up_unused_resources",
              "type": "enum",
              "values": [
                "yes",
                "no",
                "n_a"
              ],
              "label": "Clean up unused resources"
            }
          ]
        }
      ]
    },
    "registers": {
      "path": "/dashboard/registers",
      "items": [
        {
          "kind": "Infrastructure",
          "track": [
            "environments"
          ]
        },
        {
          "kind": "Accounts and systems",
          "track": [
            "CI/CD and cloud accounts (references only)"
          ]
        },
        {
          "kind": "Equipment",
          "track": [
            "build agents"
          ]
        },
        {
          "kind": "Outstanding work",
