    "playbooks": {
      "path": "/dashboard/playbooks",
      "seeds": [
        {
          "key": "troubleshooting",
          "title": "Troubleshooting",
          "frequency": "as_needed",
          "phasesFrom": "method",
          "documentedPhases": [
            "Identify",
            "Reproduce",
            "Diagnose",
            "Fix",
            "Test",
            "Document"
          ],
          "source": "handover s25"
        },
        {
          "key": "backup_procedure",
          "title": "Backup procedure and test restoration",
          "frequency": "weekly",
          "phasesFrom": "custom",
          "source": "handover s6-8",
          "phases": [
            {
              "name": "Before backup",
              "steps": [
                "Confirm backup system is operational",
                "Check available storage",
                "Review previous backup status",
                "Check unresolved warnings",
                "Confirm critical servers/services are available",
                "Confirm correct backup job is scheduled"
              ]
            },
            {
              "name": "During backup",
              "steps": [
                "Monitor progress",
                "Monitor error messages",
                "Monitor storage utilisation",
                "Monitor network connectivity",
                "Avoid unnecessary server changes"
              ]
            },
            {
              "name": "After backup",
              "steps": [
                "Verify completed successfully",
                "Confirm no critical errors",
                "Confirm backup files are accessible",
                "Compare size with previous backups",
                "Confirm destination is available",
                "Confirm retention requirements",
                "Record result in backup log"
              ]
            },
            {
              "name": "Test restoration",
              "steps": [
                "Select a non-critical test file or approved dataset",
                "Restore to a test location",
                "Confirm restored data opens",
                "Compare with original where appropriate",
                "Record the result",
                "Report any failure immediately"
              ]
            }
          ]
        },
        {
          "key": "new_computer_setup",
          "title": "New computer setup",
          "frequency": "as_needed",
          "phasesFrom": "custom",
          "source": "handover s16",
          "phases": [
            {
              "name": "Setup",
              "steps": [
                "Record asset information",
                "Install approved OS if necessary",
                "Apply OS updates",
                "Install required drivers",
                "Install approved applications",
                "Configure security/endpoint protection",
                "Configure network access",
                "Configure email/productivity applications",
                "Apply organisational settings",
                "Test internet/network access",
                "Test required applications",
                "Test printing where applicable",
                "Assign device in asset register",
                "Record the handover"
              ]
            }
          ]
        },
        {
          "key": "user_offboarding",
          "title": "User offboarding",
          "frequency": "as_needed",
          "phasesFrom": "custom",
          "source": "handover s17",
          "phases": [
            {
              "name": "Offboarding",
              "steps": [
                "Collect company IT equipment",
                "Record returned assets",
                "Secure the computer",
                "Coordinate account deactivation with the appropriate administrator",
                "Preserve required business data per policy",
                "Remove device from user's assignment",
                "Prepare device for reassignment or secure disposal"
              ],
              "rules": [
                "Do not delete organisational data or disable accounts without authorisation"
              ]
            }
          ]
        },
        {
          "key": "incident_escalation",
