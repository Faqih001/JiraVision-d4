          "source": "maintenance_log",
          "sourceType": "log",
          "aggregation": "count",
          "defaultTarget": null,
          "computedBy": "code"
        }
      ],
      "recommendRules": [
        {
          "id": "no_backup_result_for_a_server_in_7_days",
          "when": "no backup result for a server in 7 days",
          "suggest": "investigate and log",
          "deterministic": true
        },
        {
          "id": "backup_failed_or_warning_unresolved",
          "when": "backup failed or warning unresolved",
          "suggest": "open a critical ticket",
          "deterministic": true
        },
        {
          "id": "no_restore_test_in_30_days",
          "when": "no restore test in 30 days",
          "suggest": "schedule one",
          "deterministic": true
        },
        {
          "id": "free_storage_below_20",
          "when": "free storage below 20%",
          "suggest": "raise capacity recommendation",
          "deterministic": true
        },
        {
          "id": "ticket_past_priority_target",
          "when": "ticket past priority target",
          "suggest": "escalate",
          "deterministic": true
        },
        {
          "id": "licence_expiring_in_30_days",
          "when": "licence expiring in 30 days",
          "suggest": "plan renewal",
          "deterministic": true
        }
      ]
    },
