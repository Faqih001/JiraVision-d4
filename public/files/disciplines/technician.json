        "data": "in-person and remote procedures; priorities Critical/High/Medium/Low"
      },
      {
        "section": "5 Wi-Fi",
        "surface": "/dashboard/registers",
        "data": "corporate WPA3-Enterprise SSID; guest isolated VLAN, captive portal, client isolation, rate-limiting; controller dashboard"
      },
      {
        "section": "6-8 Backups",
        "surface": "/dashboard/ops/logs:backups,restore_tests",
        "data": "3 servers; weekly/monthly server backups; cloud nightly incremental, monthly full; cloud retention 30 days/3 months/1 year"
      },
      {
        "section": "9-17 Hardware, software, maintenance",
        "surface": "/dashboard/registers",
        "data": "device categories, procedures"
      },
      {
        "section": "18 Security",
        "surface": "/dashboard/ops/logs:incidents",
        "data": "monitoring list, security rules"
      },
      {
        "section": "19 Escalation",
        "surface": "/dashboard/ops/logs:incidents",
        "data": "9 triggers; 10 record fields"
      },
      {
        "section": "20 Maintenance schedule",
        "surface": "/dashboard/tasks",
        "data": "daily 6, weekly 8, monthly 8, quarterly 7 recurring items"
      },
      {
        "section": "21 Documentation",
        "surface": "/dashboard/registers",
        "data": "14 record categories"
      },
      {
        "section": "22 Daily checklist",
        "surface": "/dashboard/ops/logs:daily_checklist",
        "data": "17 items (7 system, 5 user support, 5 documentation)"
      },
      {
        "section": "23 Weekly checklist",
        "surface": "/dashboard/ops/logs:weekly_checklist",
        "data": "13 items"
      },
      {
        "section": "24 Monthly report",
        "surface": "/dashboard/reports-work",
        "data": "6 sections: support, backups, hardware, software, maintenance, risks/recommendations"
      },
      {
        "section": "25-27 Troubleshooting and handover",
        "surface": "/dashboard/playbooks",
        "data": "6-step method; handover checklists"
      }
    ]
  },
