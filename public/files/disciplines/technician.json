          "defaultTarget": null,
          "computedBy": "code"
        },
        {
          "id": "tickets_resolved",
          "label": "Tickets resolved",
          "source": "tickets",
          "sourceType": "log",
          "aggregation": "count",
          "defaultTarget": null,
          "computedBy": "code"
        },
        {
          "id": "backup_success_rate",
          "label": "Backup success rate",
          "source": "backups",
