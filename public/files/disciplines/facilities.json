        {
          "id": "areas_needing_action",
          "label": "Areas needing action",
          "source": "facility_inspections",
          "sourceType": "log",
          "aggregation": "count",
          "defaultTarget": null,
          "computedBy": "code"
        },
        {
          "id": "requests_open",
          "label": "Requests open",
          "source": "service_requests",
          "sourceType": "log",
          "aggregation": "open_count",
          "defaultTarget": null,
          "computedBy": "code"
        },
        {
          "id": "requests_done",
          "label": "Requests done",
          "source": "service_requests",
          "sourceType": "log",
          "aggregation": "count",
          "defaultTarget": null,
          "computedBy": "code"
        }
      ],
      "recommendRules": [
        {
          "id": "request_open_over_5_days",
          "when": "request open over 5 days",
          "suggest": "escalate",
          "deterministic": true
        },
        {
          "id": "area_needing_action_twice",
          "when": "area needing action twice",
          "suggest": "plan repair",
          "deterministic": true
        }
      ]
    },
