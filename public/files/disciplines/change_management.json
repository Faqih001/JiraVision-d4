            },
            {
              "key": "completed_by",
              "type": "text"
            },
            {
              "key": "review_new_change_requests",
              "type": "enum",
              "values": [
                "yes",
                "no",
                "n_a"
              ],
              "label": "Review new change requests"
            },
            {
              "key": "check_implementation_tasks_due",
              "type": "enum",
              "values": [
                "yes",
                "no",
                "n_a"
              ],
              "label": "Check implementation tasks due"
