    "playbooks": {
      "path": "/dashboard/playbooks",
      "seeds": [
        {
          "key": "change_advisory_review",
          "title": "Change advisory review",
          "frequency": "weekly",
          "phasesFrom": "custom",
          "phases": [
            {
              "name": "Steps",
              "steps": [
                "List requests and impacts",
                "Check risk and rollback plan",
                "Check readiness and approvals",
                "Approve, defer or reject",
                "Record decisions and dates"
              ]
            }
          ],
          "methodTagging": "work-log entries may be tagged with a phase from getMethodForDiscipline"
        },
        {
          "key": "impact_assessment",
          "title": "Impact assessment",
          "frequency": "as_needed",
          "phasesFrom": "custom",
          "phases": [
            {
              "name": "Steps",
              "steps": [
                "Describe the change",
                "Identify affected groups and processes",
                "Rate impact and effort",
                "Define training and communication needs",
                "Document mitigation"
              ]
            }
          ],
          "methodTagging": "work-log entries may be tagged with a phase from getMethodForDiscipline"
        },
        {
          "key": "adoption_tracking",
          "title": "Adoption tracking",
          "frequency": "monthly",
          "phasesFrom": "custom",
          "phases": [
            {
              "name": "Steps",
              "steps": [
                "Define adoption measures",
                "Collect usage and feedback",
                "Compare to target",
                "Plan interventions for low adoption",
                "Report results"
              ]
            }
          ],
          "methodTagging": "work-log entries may be tagged with a phase from getMethodForDiscipline"
        },
        {
          "key": "post_implementation_review",
          "title": "Post-implementation review",
          "frequency": "as_needed",
          "phasesFrom": "custom",
          "phases": [
            {
              "name": "Steps",
              "steps": [
                "Confirm the change was delivered",
                "Compare to objectives",
                "Collect lessons",
                "Close open actions",
                "Archive records"
              ]
            }
          ],
          "methodTagging": "work-log entries may be tagged with a phase from getMethodForDiscipline"
        },
        {
          "key": "escalation",
          "title": "Escalation",
          "frequency": "as_needed",
          "phasesFrom": "custom",
          "triggers": [
            "Change causes service disruption",
            "Key stakeholder opposes the change",
            "Low adoption after two checks",
            "Compliance impact discovered",
            "Rollback required"
          ],
          "recordFields": [
            "date_time",
            "affected_area_or_system",
            "people_affected_by_code_or_count",
            "description",
            "actions_taken",
            "evidence_or_logs",
            "impact",
            "person_or_party_contacted",
            "current_status"
          ],
          "rules": [
            "Record facts; escalate promptly when a trigger is met"
          ]
        },
        {
          "key": "role_handover",
          "title": "Role handover",
          "frequency": "as_needed",
          "phasesFrom": "custom",
          "phases": [
            {
              "name": "Handover",
              "steps": [
                "Transfer Initiatives: change initiatives",
                "Transfer Stakeholders: impacted groups",
                "Transfer Risks: change risks",
                "List open work, deadlines and commitments",
                "Share trackers, templates and contacts",
                "Transfer accounts and access only through the approved secure process, never in documents",
                "Brief the successor and confirm access",
                "Review progress after one week"
              ]
            }
          ]
        }
      ]
    },
