{
  "schemaVersion": 1,
  "discipline": {
    "key": "change_management",
    "label": "Change management",
    "category": "delivery",
    "categoryLabel": "Management & project delivery",
    "focus": "Change requests, impact assessment and adoption"
  },
  "pack": {
    "key": "management",
    "reportTemplate": "general",
    "registerKinds": [
      "Initiatives",
      "Stakeholders",
      "Risks",
      "Reports"
    ],
    "ladderDiscipline": {
      "proposed": "coordinator",
      "verifyIn": "lib/auto-populate.ts"
    }
  },
  "provenance": {
    "type": "proposed-seed",
    "sourceDocument": null,
    "reviewRequired": true,
    "reviewerRole": "experienced change management practitioner",
    "note": "Starting seed written without a source document. Not professional, clinical, legal, financial or safety advice. A practitioner must review before use.",
    "detailLevel": "detailed"
  },
  "method": {
    "resolveAtRuntime": "getMethodForDiscipline(pack, discipline)",
    "documentedSequence": null,
    "documentedIn": null
  },
  "surfaces": {
    "overview": {
      "path": "/dashboard/ops",
      "kpis": [
        {
          "id": "changes_implemented",
          "label": "Changes implemented",
          "source": "change_requests",
          "sourceType": "log",
          "aggregation": "count",
          "defaultTarget": null,
          "computedBy": "code"
        },
        {
          "id": "approvals_pending",
          "label": "Approvals pending",
          "source": "change_requests",
          "sourceType": "log",
          "aggregation": "open_count",
          "defaultTarget": null,
          "computedBy": "code"
        },
        {
          "id": "groups_with_low_adoption",
          "label": "Groups with low adoption",
          "source": "adoption_checks",
          "sourceType": "log",
          "aggregation": "count",
          "defaultTarget": null,
          "computedBy": "code"
        },
        {
          "id": "change_requests_logged",
          "label": "Change requests logged",
          "source": "change_requests",
          "sourceType": "log",
          "aggregation": "count",
          "defaultTarget": null,
          "computedBy": "code"
        }
      ],
      "recommendRules": [
        {
          "id": "approval_pending_over_5_days",
          "when": "approval pending over 5 days",
          "suggest": "chase approver",
          "deterministic": true
        },
        {
          "id": "low_adoption_twice_in_a_row",
          "when": "low adoption twice in a row",
          "suggest": "plan intervention",
          "deterministic": true
        }
      ]
    },
    "logs": {
      "path": "/dashboard/ops/logs",
      "entities": [
        {
          "key": "change_requests",
          "label": "Change requests",
          "fields": [
            {
              "key": "received_date",
              "type": "date"
            },
            {
              "key": "change",
              "type": "text"
            },
            {
              "key": "impact",
              "type": "enum",
              "values": [
                "low",
                "medium",
                "high"
              ]
            },
            {
              "key": "approver",
              "type": "text"
            },
            {
              "key": "status",
              "type": "enum",
              "values": [
                "submitted",
                "approved",
                "implemented",
                "rejected"
              ]
            }
          ]
        },
        {
          "key": "adoption_checks",
          "label": "Adoption checks",
          "fields": [
            {
              "key": "check_date",
              "type": "date"
            },
            {
              "key": "group",
              "type": "text"
            },
            {
              "key": "adoption_level",
              "type": "enum",
              "values": [
                "low",
                "medium",
                "high"
              ]
            },
            {
              "key": "action",
              "type": "text"
            }
          ]
        },
        {
          "key": "daily_checklist",
