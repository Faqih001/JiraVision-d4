                "n_a"
              ],
              "label": "Stakeholder communications update"
            },
            {
              "key": "check_training_and_readiness_progress",
              "type": "enum",
              "values": [
                "yes",
                "no",
                "n_a"
              ],
              "label": "Check training and readiness progress"
            },
            {
              "key": "review_resistance_and_issues",
              "type": "enum",
              "values": [
                "yes",
                "no",
                "n_a"
              ],
              "label": "Review resistance and issues"
            },
            {
              "key": "update_the_change_plan",
              "type": "enum",
              "values": [
                "yes",
                "no",
                "n_a"
              ],
              "label": "Update the change plan"
