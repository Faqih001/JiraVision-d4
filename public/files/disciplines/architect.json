    "playbooks": {
      "path": "/dashboard/playbooks",
      "seeds": [
        {
          "key": "design_review",
          "title": "Design review",
          "frequency": "weekly",
          "phasesFrom": "custom",
          "phases": [
            {
              "name": "Steps",
              "steps": [
                "Collect the design document and context",
                "Check requirements and constraints",
                "Review options and trade-offs",
                "Check security, scale, cost and operability",
                "Record findings and decision",
                "Follow up on actions"
              ]
            }
          ],
          "methodTagging": "work-log entries may be tagged with a phase from getMethodForDiscipline"
        },
        {
          "key": "architecture_decision_record",
          "title": "Architecture decision record",
          "frequency": "as_needed",
          "phasesFrom": "custom",
          "phases": [
            {
              "name": "Steps",
              "steps": [
                "State the problem and constraints",
                "List options with pros and cons",
                "Choose and justify",
                "Note consequences and risks",
                "Get approval",
                "Publish and link"
              ]
            }
          ],
          "methodTagging": "work-log entries may be tagged with a phase from getMethodForDiscipline"
        },
        {
          "key": "technical_debt_assessment",
          "title": "Technical debt assessment",
          "frequency": "quarterly",
          "phasesFrom": "custom",
          "phases": [
            {
              "name": "Steps",
              "steps": [
                "List debt items",
                "Rate impact and effort",
                "Link to risks",
                "Prioritise",
                "Agree a paydown plan"
              ]
            }
          ],
          "methodTagging": "work-log entries may be tagged with a phase from getMethodForDiscipline"
        },
        {
          "key": "architecture_governance",
          "title": "Architecture governance",
          "frequency": "monthly",
          "phasesFrom": "custom",
          "phases": [
            {
              "name": "Steps",
              "steps": [
                "Review exceptions to standards",
                "Decide approve or reject",
                "Update guidelines",
                "Communicate changes"
              ]
            }
          ],
          "methodTagging": "work-log entries may be tagged with a phase from getMethodForDiscipline"
        },
        {
          "key": "escalation",
          "title": "Escalation",
          "frequency": "as_needed",
          "phasesFrom": "custom",
          "triggers": [
            "Design conflicts with security or compliance",
            "Single point of failure found",
            "Cost exceeds budget materially",
            "Vendor lock-in risk",
            "Teams diverge on a core standard"
          ],
          "recordFields": [
            "date_time",
            "affected_area_or_system",
            "people_affected_by_code_or_count",
            "description",
            "actions_taken",
            "evidence_or_logs",
            "impact",
            "person_or_party_contacted",
            "current_status"
          ],
          "rules": [
            "Record facts; escalate promptly when a trigger is met"
          ]
        },
        {
          "key": "role_handover",
          "title": "Role handover",
          "frequency": "as_needed",
          "phasesFrom": "custom",
          "phases": [
            {
              "name": "Handover",
              "steps": [
                "Transfer Code repositories: architecture decision records",
                "Transfer Technical debt: architectural debt",
                "Transfer Pull requests: design reviews",
                "List open work, deadlines and commitments",
                "Share trackers, templates and contacts",
                "Transfer accounts and access only through the approved secure process, never in documents",
                "Brief the successor and confirm access",
                "Review progress after one week"
              ]
            }
          ]
        }
      ]
    },
