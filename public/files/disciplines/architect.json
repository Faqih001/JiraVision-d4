            },
            {
              "key": "decision",
              "type": "text"
            },
            {
              "key": "status",
              "type": "enum",
              "values": [
                "proposed",
                "accepted",
                "superseded"
              ]
            }
          ]
        },
        {
          "key": "design_reviews",
          "label": "Design reviews",
