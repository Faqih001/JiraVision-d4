  "surfaces": {
    "overview": {
      "path": "/dashboard/ops",
      "kpis": [
        {
          "id": "checks_compliant",
          "label": "Checks compliant",
          "source": "compliance_checks",
          "sourceType": "log",
          "aggregation": "count",
          "defaultTarget": null,
          "computedBy": "code"
        },
        {
          "id": "gaps_open",
          "label": "Gaps open",
          "source": "compliance_checks",
          "sourceType": "log",
          "aggregation": "open_count",
          "defaultTarget": null,
          "computedBy": "code"
        },
        {
          "id": "attestations_complete",
          "label": "Attestations complete",
          "source": "policy_attestations",
          "sourceType": "log",
          "aggregation": "count",
          "defaultTarget": null,
          "computedBy": "code"
        },
        {
          "id": "actions_overdue",
          "label": "Actions overdue",
          "source": "compliance_checks",
          "sourceType": "log",
          "aggregation": "overdue_count",
          "defaultTarget": null,
          "computedBy": "code"
        }
      ],
      "recommendRules": [
        {
          "id": "gap_without_action_date",
          "when": "gap without action date",
          "suggest": "set date",
          "deterministic": true
        },
        {
          "id": "attestation_incomplete_after_deadline",
          "when": "attestation incomplete after deadline",
          "suggest": "chase",
          "deterministic": true
        }
      ]
    },
