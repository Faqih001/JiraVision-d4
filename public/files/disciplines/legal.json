    "playbooks": {
      "path": "/dashboard/playbooks",
      "seeds": [
        {
          "key": "contract_review",
          "title": "Contract review",
          "frequency": "weekly",
          "phasesFrom": "custom",
          "phases": [
            {
              "name": "Steps",
              "steps": [
                "Read the whole contract",
                "Check key terms, liability and exit",
                "Mark risks and proposed changes",
                "Negotiate",
                "Approve",
                "Sign and store"
              ]
            }
          ],
          "methodTagging": "work-log entries may be tagged with a phase from getMethodForDiscipline"
        },
        {
          "key": "legal_query",
          "title": "Legal query",
          "frequency": "as_needed",
          "phasesFrom": "custom",
          "phases": [
            {
              "name": "Steps",
              "steps": [
                "Log the question and deadline",
                "Clarify facts",
                "Research and advise",
                "Record the advice",
                "Follow up"
              ]
            }
          ],
          "methodTagging": "work-log entries may be tagged with a phase from getMethodForDiscipline"
        },
        {
          "key": "dispute_or_claim",
          "title": "Dispute or claim",
          "frequency": "as_needed",
          "phasesFrom": "custom",
          "phases": [
            {
              "name": "Steps",
              "steps": [
                "Preserve documents",
                "Assess the position",
                "Decide strategy",
                "Communicate with the other side",
                "Record and report"
              ]
            }
          ],
          "methodTagging": "work-log entries may be tagged with a phase from getMethodForDiscipline"
        },
        {
          "key": "policy_update",
          "title": "Policy update",
          "frequency": "as_needed",
          "phasesFrom": "custom",
          "phases": [
            {
              "name": "Steps",
              "steps": [
                "Identify the law change",
                "Draft the change",
                "Consult",
                "Approve",
                "Communicate and train"
              ]
            }
          ],
          "methodTagging": "work-log entries may be tagged with a phase from getMethodForDiscipline"
        },
        {
          "key": "escalation",
          "title": "Escalation",
          "frequency": "as_needed",
          "phasesFrom": "custom",
          "triggers": [
            "Litigation or regulator notice",
            "Contract breach with high exposure",
            "Legal deadline at risk",
            "Conflict of interest",
            "Privileged material exposed"
