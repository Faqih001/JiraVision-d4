        {
          "key": "contract_review",
          "title": "Contract review",
          "frequency": "as_needed",
          "phasesFrom": "custom",
          "phases": [
            {
              "name": "Steps",
              "steps": [
                "Read key terms and obligations",
                "Check price, term, renewal and exit",
                "Check risks with legal where needed",
                "Negotiate",
                "Approve",
                "Sign and store"
              ]
            }
          ],
          "methodTagging": "work-log entries may be tagged with a phase from getMethodForDiscipline"
        },
        {
          "key": "pricing_decision",
          "title": "Pricing decision",
          "frequency": "as_needed",
          "phasesFrom": "custom",
          "phases": [
            {
              "name": "Steps",
              "steps": [
                "State the product and cost basis",
                "Review market and margin",
                "Propose a price",
                "Get approval",
                "Communicate and record"
              ]
            }
          ],
          "methodTagging": "work-log entries may be tagged with a phase from getMethodForDiscipline"
        },
        {
          "key": "renewal_management",
