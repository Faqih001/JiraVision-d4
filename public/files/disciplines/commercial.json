          "frequency": "as_needed",
          "phasesFrom": "custom",
          "phases": [
            {
              "name": "Steps",
              "steps": [
                "Record facts and documents",
                "Review the contract",
                "Engage the counterparty",
                "Escalate with options",
                "Record the settlement"
              ]
            }
          ],
          "methodTagging": "work-log entries may be tagged with a phase from getMethodForDiscipline"
        },
        {
          "key": "escalation",
