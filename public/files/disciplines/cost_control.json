          "defaultTarget": null,
          "computedBy": "code"
        }
      ],
      "recommendRules": [
        {
          "id": "cost_centre_over_budget",
          "when": "cost centre over budget",
          "suggest": "explain variance",
          "deterministic": true
        },
        {
          "id": "approval_pending_over_3_days",
          "when": "approval pending over 3 days",
          "suggest": "chase",
          "deterministic": true
        }
      ]
