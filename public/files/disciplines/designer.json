        "Accessibility audit results"
      ]
    },
    "playbooks": {
      "path": "/dashboard/playbooks",
      "seeds": [
        {
          "key": "design_critique",
          "title": "Design critique",
          "frequency": "weekly",
          "phasesFrom": "custom",
          "phases": [
            {
              "name": "Steps",
              "steps": [
                "Share goals and context",
                "Present the design",
                "Collect feedback by theme",
                "Decide what to change",
                "Record actions"
              ]
            }
          ],
          "methodTagging": "work-log entries may be tagged with a phase from getMethodForDiscipline"
        },
        {
          "key": "handoff_checklist",
          "title": "Handoff checklist",
          "frequency": "weekly",
          "phasesFrom": "custom",
          "phases": [
            {
              "name": "Steps",
              "steps": [
                "Check states, edge cases and responsive layouts",
                "Confirm spacing, type and colour tokens",
                "Provide assets and specs",
                "Annotate interactions",
                "Review the build with the developer"
              ]
            }
          ],
          "methodTagging": "work-log entries may be tagged with a phase from getMethodForDiscipline"
        },
        {
          "key": "usability_test",
          "title": "Usability test",
          "frequency": "as_needed",
          "phasesFrom": "custom",
          "phases": [
            {
              "name": "Steps",
              "steps": [
                "Define goals and tasks",
                "Recruit participants",
                "Run sessions",
                "Note findings and severity",
                "Share recommendations"
              ]
            }
          ],
          "methodTagging": "work-log entries may be tagged with a phase from getMethodForDiscipline"
        },
        {
          "key": "design_system_update",
          "title": "Design system update",
          "frequency": "monthly",
          "phasesFrom": "custom",
          "phases": [
            {
              "name": "Steps",
              "steps": [
                "Identify new or changed components",
                "Design and document usage",
                "Review with engineers",
                "Publish a version",
                "Announce changes"
              ]
            }
          ],
          "methodTagging": "work-log entries may be tagged with a phase from getMethodForDiscipline"
        },
        {
          "key": "escalation",
          "title": "Escalation",
          "frequency": "as_needed",
          "phasesFrom": "custom",
          "triggers": [
            "Accessibility failure found",
            "Brand or legal conflict",
            "Scope change late in design",
            "Developer cannot implement the design",
            "Source files lost"
          ],
          "recordFields": [
            "date_time",
            "affected_area_or_system",
            "people_affected_by_code_or_count",
            "description",
            "actions_taken",
            "evidence_or_logs",
            "impact",
            "person_or_party_contacted",
            "current_status"
          ],
          "rules": [
            "Record facts; escalate promptly when a trigger is met"
          ]
        },
        {
          "key": "role_handover",
          "title": "Role handover",
          "frequency": "as_needed",
          "phasesFrom": "custom",
          "phases": [
            {
              "name": "Handover",
              "steps": [
                "Transfer Design files: active files and owners",
                "Transfer Brand assets: asset library",
                "Transfer User research: studies and findings",
                "Transfer Design system: components and tokens",
                "List open work, deadlines and commitments",
                "Share trackers, templates and contacts",
                "Transfer accounts and access only through the approved secure process, never in documents",
                "Brief the successor and confirm access",
                "Review progress after one week"
              ]
            }
          ]
        }
      ]
    },
