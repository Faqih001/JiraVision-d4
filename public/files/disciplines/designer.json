{
  "schemaVersion": 1,
  "discipline": {
    "key": "designer",
    "label": "Designer",
    "category": "technology",
    "categoryLabel": "Software, IT & digital",
    "focus": "Design delivery, critique and handoff"
  },
  "pack": {
    "key": "designer",
    "reportTemplate": "creative",
    "registerKinds": [
      "Design files",
      "Brand assets",
      "User research",
      "Design system"
    ],
    "ladderDiscipline": {
      "proposed": "designer",
      "verifyIn": "lib/auto-populate.ts"
    }
  },
  "provenance": {
    "type": "proposed-seed",
    "sourceDocument": null,
    "reviewRequired": true,
    "reviewerRole": "experienced designer practitioner",
    "note": "Starting seed written without a source document. Not professional, clinical, legal, financial or safety advice. A practitioner must review before use.",
    "detailLevel": "detailed"
  },
  "method": {
    "resolveAtRuntime": "getMethodForDiscipline(pack, discipline)",
    "documentedSequence": null,
    "documentedIn": null
  },
  "surfaces": {
    "overview": {
      "path": "/dashboard/ops",
      "kpis": [
        {
          "id": "reviews_approved",
          "label": "Reviews approved",
          "source": "design_reviews",
          "sourceType": "log",
          "aggregation": "count",
          "defaultTarget": null,
          "computedBy": "code"
        },
        {
          "id": "revision_rounds_per_deliverable",
          "label": "Revision rounds per deliverable",
          "source": "design_reviews",
          "sourceType": "log",
          "aggregation": "avg",
          "defaultTarget": null,
          "computedBy": "code"
        },
        {
          "id": "usability_tests_run",
          "label": "Usability tests run",
          "source": "usability_tests",
          "sourceType": "log",
          "aggregation": "count",
          "defaultTarget": null,
          "computedBy": "code"
        },
        {
          "id": "design_system_items",
          "label": "Design system items",
          "source": "design_system",
          "sourceType": "register",
          "aggregation": "count",
          "defaultTarget": null,
          "computedBy": "code"
        }
      ],
      "recommendRules": [
        {
          "id": "deliverable_on_third_revision_round",
          "when": "deliverable on third revision round",
          "suggest": "agree scope",
          "deterministic": true
        },
        {
          "id": "handoff_without_checklist",
          "when": "handoff without checklist",
          "suggest": "complete it",
          "deterministic": true
        }
      ]
    },
    "logs": {
      "path": "/dashboard/ops/logs",
      "entities": [
        {
          "key": "design_reviews",
          "label": "Design reviews",
          "fields": [
            {
              "key": "review_date",
              "type": "date"
            },
            {
              "key": "deliverable",
              "type": "text"
            },
            {
              "key": "round",
              "type": "number"
            },
            {
              "key": "outcome",
              "type": "enum",
              "values": [
                "approved",
                "changes",
                "rejected"
              ]
            }
          ]
        },
        {
          "key": "usability_tests",
          "label": "Usability tests",
          "fields": [
            {
              "key": "test_date",
              "type": "date"
            },
            {
              "key": "prototype",
              "type": "text"
            },
            {
              "key": "participant_count",
              "type": "number"
            },
            {
              "key": "key_findings",
              "type": "text"
            }
          ]
        },
        {
          "key": "daily_checklist",
          "label": "Daily checklist",
          "fields": [
            {
              "key": "date",
              "type": "date"
            },
            {
              "key": "completed_by",
              "type": "text"
            },
            {
              "key": "check_feedback_and_comments_on_designs",
              "type": "enum",
              "values": [
                "yes",
                "no",
                "n_a"
              ],
              "label": "Check feedback and comments on designs"
            },
            {
              "key": "work_on_planned_design_tasks",
              "type": "enum",
              "values": [
                "yes",
                "no",
                "n_a"
              ],
              "label": "Work on planned design tasks"
            },
            {
              "key": "sync_with_developers_on_questions",
              "type": "enum",
              "values": [
                "yes",
                "no",
                "n_a"
              ],
              "label": "Sync with developers on questions"
            },
            {
              "key": "update_design_files_and_versions",
              "type": "enum",
              "values": [
                "yes",
                "no",
                "n_a"
              ],
              "label": "Update design files and versions"
            },
            {
              "key": "review_requests_in_the_design_queue",
              "type": "enum",
              "values": [
                "yes",
                "no",
                "n_a"
              ],
              "label": "Review requests in the design queue"
            }
          ]
        },
        {
          "key": "weekly_checklist",
          "label": "Weekly checklist",
          "fields": [
            {
              "key": "week_starting",
              "type": "date"
            },
            {
              "key": "completed_by",
              "type": "text"
            },
            {
              "key": "design_critique_session",
              "type": "enum",
              "values": [
                "yes",
                "no",
                "n_a"
              ],
              "label": "Design critique session"
            },
            {
              "key": "handoff_review_with_engineering",
              "type": "enum",
              "values": [
                "yes",
                "no",
                "n_a"
              ],
              "label": "Handoff review with engineering"
            },
            {
              "key": "usability_test_or_research_check",
              "type": "enum",
              "values": [
                "yes",
                "no",
                "n_a"
              ],
              "label": "Usability test or research check"
            },
            {
              "key": "update_design_system_components",
              "type": "enum",
              "values": [
                "yes",
                "no",
                "n_a"
              ],
              "label": "Update design system components"
            },
            {
              "key": "review_accessibility_issues",
              "type": "enum",
              "values": [
                "yes",
                "no",
                "n_a"
              ],
              "label": "Review accessibility issues"
            }
          ]
        }
      ]
