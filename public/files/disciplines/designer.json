    "registers": {
      "path": "/dashboard/registers",
      "items": [
        {
          "kind": "Design files",
          "track": [
            "active files and owners"
          ]
        },
        {
          "kind": "Brand assets",
          "track": [
            "asset library"
          ]
        },
        {
          "kind": "User research",
          "track": [
            "studies and findings"
          ]
        },
