          "frequency": "as_needed",
          "phasesFrom": "custom",
          "phases": [
            {
              "name": "Steps",
              "steps": [
                "Compare delivery to order",
                "Inspect quality",
                "Record discrepancies",
                "Notify the supplier",
                "Update records"
              ]
            }
          ],
          "methodTagging": "work-log entries may be tagged with a phase from getMethodForDiscipline"
        },
        {
          "key": "escalation",
          "title": "Escalation",
          "frequency": "as_needed",
          "phasesFrom": "custom",
