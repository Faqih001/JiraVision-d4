        {
          "key": "tender",
          "title": "Tender",
          "frequency": "as_needed",
          "phasesFrom": "custom",
          "phases": [
            {
              "name": "Steps",
              "steps": [
                "Define requirements and criteria",
                "Publish and answer questions",
                "Evaluate fairly",
                "Approve and award",
                "Notify bidders",
                "Record"
              ]
            }
