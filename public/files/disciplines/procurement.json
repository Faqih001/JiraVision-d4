  "surfaces": {
    "overview": {
      "path": "/dashboard/ops",
      "kpis": [
        {
          "id": "requests_approved",
          "label": "Requests approved",
          "source": "purchase_requests",
          "sourceType": "log",
          "aggregation": "count",
          "defaultTarget": null,
          "computedBy": "code"
        },
        {
          "id": "orders_received",
          "label": "Orders received",
          "source": "purchase_requests",
          "sourceType": "log",
          "aggregation": "count",
          "defaultTarget": null,
          "computedBy": "code"
        },
        {
          "id": "requests_awaiting_approval",
          "label": "Requests awaiting approval",
          "source": "purchase_requests",
          "sourceType": "log",
          "aggregation": "open_count",
          "defaultTarget": null,
          "computedBy": "code"
        },
        {
          "id": "suppliers_rated_low",
          "label": "Suppliers rated low",
          "source": "supplier_reviews",
          "sourceType": "log",
          "aggregation": "count",
          "defaultTarget": null,
          "computedBy": "code"
        }
      ],
      "recommendRules": [
        {
          "id": "request_pending_approval_over_3_days",
          "when": "request pending approval over 3 days",
          "suggest": "chase",
          "deterministic": true
        },
        {
          "id": "supplier_rated_low_twice",
          "when": "supplier rated low twice",
          "suggest": "review contract",
          "deterministic": true
        }
      ]
    },
