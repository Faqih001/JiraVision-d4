    "reports": {
      "path": "/dashboard/reports-work",
      "template": "assurance",
      "cadences": [
        "daily",
        "weekly",
        "monthly"
      ],
      "sections": [
        "Summary",
        "Experiments run",
        "Models with drift",
        "Models reviewed",
        "Datasets documented",
        "Risks and recommendations",
        "Plan for next period"
