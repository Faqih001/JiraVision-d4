    "overview": {
      "path": "/dashboard/ops",
      "kpis": [
        {
          "id": "handovers_logged",
          "label": "Handovers logged",
          "source": "shift_handovers",
          "sourceType": "log",
          "aggregation": "count",
          "defaultTarget": null,
          "computedBy": "code"
        },
        {
          "id": "open_deviations",
          "label": "Open deviations",
          "source": "process_deviations",
          "sourceType": "log",
          "aggregation": "open_count",
          "defaultTarget": null,
          "computedBy": "code"
        },
        {
          "id": "deviations_resolved",
          "label": "Deviations resolved",
          "source": "process_deviations",
          "sourceType": "log",
          "aggregation": "count",
          "defaultTarget": null,
          "computedBy": "code"
        },
        {
          "id": "processes_documented",
          "label": "Processes documented",
          "source": "processes",
          "sourceType": "register",
          "aggregation": "count",
          "defaultTarget": null,
          "computedBy": "code"
        }
      ],
      "recommendRules": [
        {
          "id": "deviation_open_over_3_days",
          "when": "deviation open over 3 days",
          "suggest": "escalate",
          "deterministic": true
        },
        {
          "id": "process_not_reviewed_in_12_months",
          "when": "process not reviewed in 12 months",
          "suggest": "review",
          "deterministic": true
        }
      ]
    },
