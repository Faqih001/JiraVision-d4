{
  "schemaVersion": 1,
  "discipline": {
    "key": "devops",
    "label": "DevOps",
    "category": "technology",
    "categoryLabel": "Software, IT & digital",
    "focus": "Pipelines, deployments and infrastructure automation"
  },
  "pack": {
    "key": "it-technician",
    "reportTemplate": "technical",
    "registerKinds": [
      "Infrastructure",
      "Accounts and systems",
      "Equipment",
      "Outstanding work"
    ],
    "ladderDiscipline": {
      "proposed": "technician",
      "verifyIn": "lib/auto-populate.ts"
    }
  },
  "provenance": {
    "type": "proposed-seed",
    "sourceDocument": null,
    "reviewRequired": true,
    "reviewerRole": "experienced devops practitioner",
    "note": "Starting seed written without a source document. Not professional, clinical, legal, financial or safety advice. A practitioner must review before use."
  },
  "method": {
    "resolveAtRuntime": "getMethodForDiscipline(pack, discipline)",
    "documentedSequence": [
      "Plan",
      "Automate",
      "Deploy",
      "Monitor",
      "Optimize",
      "Document"
    ],
    "documentedIn": "roles doc section 4.7 (verify in code)"
  },
  "surfaces": {
    "overview": {
      "path": "/dashboard/ops",
      "kpis": [
        {
          "id": "deployment_success_rate",
          "label": "Deployment success rate",
          "source": "deployments",
          "sourceType": "log",
          "aggregation": "rate",
          "defaultTarget": null,
          "computedBy": "code"
        },
        {
          "id": "rollbacks",
          "label": "Rollbacks",
          "source": "deployments",
          "sourceType": "log",
          "aggregation": "count",
          "defaultTarget": null,
          "computedBy": "code"
        },
        {
          "id": "pipeline_failures_open",
          "label": "Pipeline failures open",
          "source": "pipeline_failures",
          "sourceType": "log",
          "aggregation": "open_count",
          "defaultTarget": null,
          "computedBy": "code"
        },
        {
          "id": "environments_tracked",
          "label": "Environments tracked",
          "source": "infrastructure",
          "sourceType": "register",
          "aggregation": "count",
          "defaultTarget": null,
          "computedBy": "code"
        }
      ],
      "recommendRules": [
        {
          "id": "pipeline_failing_over_1_day",
          "when": "pipeline failing over 1 day",
          "suggest": "fix",
          "deterministic": true
        },
        {
          "id": "rollback",
          "when": "rollback",
          "suggest": "add to post-mortem",
          "deterministic": true
        }
      ]
    },
    "logs": {
      "path": "/dashboard/ops/logs",
      "entities": [
        {
          "key": "deployments",
          "label": "Deployments",
          "fields": [
            {
              "key": "deploy_date",
              "type": "date"
            },
            {
              "key": "service",
              "type": "text"
            },
            {
              "key": "environment",
              "type": "enum",
              "values": [
                "dev",
                "staging",
                "production"
              ]
            },
            {
              "key": "result",
              "type": "enum",
              "values": [
                "success",
                "failed"
              ]
            },
            {
              "key": "rollback",
              "type": "enum",
              "values": [
                "yes",
                "no"
              ]
            }
          ]
        },
        {
          "key": "pipeline_failures",
          "label": "Pipeline failures",
          "fields": [
            {
              "key": "failure_date",
              "type": "date"
            },
            {
              "key": "pipeline",
              "type": "text"
            },
            {
              "key": "cause",
              "type": "text"
            },
            {
              "key": "fixed_date",
              "type": "date"
            }
          ]
        }
      ]
    },
    "registers": {
      "path": "/dashboard/registers",
      "items": [
        {
          "kind": "Infrastructure",
          "track": [
            "environments"
          ]
        },
        {
          "kind": "Accounts and systems",
          "track": [
            "CI/CD and cloud accounts (references only)"
          ]
        },
        {
          "kind": "Equipment",
          "track": [
            "build agents"
          ]
        },
        {
          "kind": "Outstanding work",
          "track": [
            "automation backlog"
          ]
        }
      ]
    },
    "playbooks": {
      "path": "/dashboard/playbooks",
      "seeds": [
        {
          "key": "daily_pipeline_health",
          "title": "Daily pipeline health",
          "frequency": "daily",
          "phasesFrom": "method"
        },
        {
          "key": "weekly_deployment_review",
          "title": "Weekly deployment review",
          "frequency": "weekly",
          "phasesFrom": "method"
        },
        {
          "key": "monthly_infrastructure_cost_review",
          "title": "Monthly infrastructure cost review",
          "frequency": "monthly",
          "phasesFrom": "method"
        },
        {
          "key": "quarterly_resilience_test",
          "title": "Quarterly resilience test",
          "frequency": "quarterly",
          "phasesFrom": "method"
        }
      ]
    },
    "tasks": {
      "path": "/dashboard/tasks",
      "recurringTemplates": [
        {
          "title": "Daily pipeline health",
          "frequency": "daily",
          "playbookKey": "daily_pipeline_health"
        },
        {
          "title": "Weekly deployment review",
          "frequency": "weekly",
          "playbookKey": "weekly_deployment_review"
        },
        {
          "title": "Monthly infrastructure cost review",
          "frequency": "monthly",
          "playbookKey": "monthly_infrastructure_cost_review"
        },
        {
          "title": "Quarterly resilience test",
          "frequency": "quarterly",
          "playbookKey": "quarterly_resilience_test"
        }
      ]
    },
    "reports": {
      "path": "/dashboard/reports-work",
      "template": "technical",
      "cadences": [
        "daily",
        "weekly",
        "monthly"
      ],
      "sections": [
        "Summary",
        "Deployment success rate",
        "Rollbacks",
        "Pipeline failures open",
        "Environments tracked",
        "Risks and recommendations",
        "Plan for next period"
      ]
    }
  },
  "ai": {
    "policy": {
      "level": "standard",
      "neverSendRegisterKinds": [],
      "neverSendEntities": [],
      "neverSendFields": [
        "passwords",
        "keys",
        "tokens",
        "personal identifiers"
      ],
      "numbers": "never produced or altered by the model; computed in code"
    },
    "agents": [
      {
        "id": "G0",
        "page": "/onboarding",
        "flavour": "classify an unmapped job title into this discipline (enum-validated; deterministic map wins)"
      },
      {
        "id": "G1",
        "page": "/dashboard/agent",
        "flavour": "extract register rows and playbook drafts for DevOps from a pasted procedure or handover"
      },
      {
        "id": "G2",
        "page": "/dashboard/tasks",
        "flavour": "triage a free-text request into task fields"
      },
      {
        "id": "G3",
        "page": "/dashboard/worklog",
        "flavour": "turn rough notes into work-log entries tagged to a method phase"
      },
      {
        "id": "G4",
        "page": "/dashboard/ops/logs",
        "flavour": "read pasted text into: deployments, pipeline_failures"
      },
      {
        "id": "G5",
        "page": "/dashboard/reports-work",
        "flavour": "draft summary and recommendation text only; numbers come from the server"
      },
      {
        "id": "G6",
        "page": "/dashboard/automation",
        "flavour": "draft rules from plain language; dry-run before enabling"
      },
      {
        "id": "G8",
        "page": "/dashboard/ops",
        "flavour": "turn deterministic rule facts into recommendation text"
      },
      {
        "id": "G11",
        "page": "/dashboard/playbooks",
        "flavour": "draft playbook phases from procedure text using the DevOps method"
      }
    ]
  },
  "needsConfirmation": [
    "KPI targets are unset (defaultTarget null): the owner and their manager must set them.",
    "Field names, enums and playbook titles are proposals: confirm against local practice.",
    "Entities technician defines (tickets, backups, restore_tests, incidents, maintenance_log) may be reused rather than duplicated."
  ]
}