        {
          "id": "contracts_reviewed",
          "label": "Contracts reviewed",
          "source": "contract_reviews",
          "sourceType": "log",
          "aggregation": "count",
          "defaultTarget": null,
          "computedBy": "code"
        },
        {
          "id": "queries_answered",
          "label": "Queries answered",
          "source": "legal_queries",
          "sourceType": "log",
          "aggregation": "count",
          "defaultTarget": null,
          "computedBy": "code"
        },
        {
          "id": "queries_overdue",
          "label": "Queries overdue",
          "source": "legal_queries",
          "sourceType": "log",
          "aggregation": "overdue_count",
          "defaultTarget": null,
          "computedBy": "code"
        },
        {
          "id": "obligations_tracked",
          "label": "Obligations tracked",
          "source": "compliance",
          "sourceType": "register",
          "aggregation": "count",
          "defaultTarget": null,
          "computedBy": "code"
        }
      ],
      "recommendRules": [
        {
          "id": "query_past_due_date",
          "when": "query past due date",
          "suggest": "respond",
          "deterministic": true
        },
        {
          "id": "high_risk_contract_unreviewed_3_days",
          "when": "high-risk contract unreviewed 3 days",
          "suggest": "prioritise",
          "deterministic": true
        }
      ]
    },
