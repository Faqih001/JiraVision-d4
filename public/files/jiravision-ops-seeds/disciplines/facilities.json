        {
          "id": "areas_needing_action",
          "label": "Areas needing action",
          "source": "facility_inspections",
          "sourceType": "log",
          "aggregation": "count",
          "defaultTarget": null,
          "computedBy": "code"
        },
        {
          "id": "requests_open",
          "label": "Requests open",
          "source": "service_requests",
          "sourceType": "log",
          "aggregation": "open_count",
          "defaultTarget": null,
          "computedBy": "code"
        },
        {
          "id": "requests_done",
          "label": "Requests done",
          "source": "service_requests",
          "sourceType": "log",
          "aggregation": "count",
          "defaultTarget": null,
          "computedBy": "code"
        }
