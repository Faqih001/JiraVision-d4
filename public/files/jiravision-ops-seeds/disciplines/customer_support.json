{
  "schemaVersion": 1,
  "discipline": {
    "key": "customer_support",
    "label": "Customer support",
    "category": "market",
    "categoryLabel": "Sales, marketing & customer",
    "focus": "Tickets, response times and satisfaction"
  },
  "pack": {
    "key": "sales-marketing",
    "reportTemplate": "creative",
    "registerKinds": [
      "Leads",
      "Campaigns",
      "Customers",
      "Metrics"
    ],
    "ladderDiscipline": {
      "proposed": "sales_marketing",
      "verifyIn": "lib/auto-populate.ts"
    }
  },
  "provenance": {
    "type": "proposed-seed",
    "sourceDocument": null,
    "reviewRequired": true,
    "reviewerRole": "experienced customer support practitioner",
    "note": "Starting seed written without a source document. Not professional, clinical, legal, financial or safety advice. A practitioner must review before use."
  },
  "method": {
    "resolveAtRuntime": "getMethodForDiscipline(pack, discipline)",
    "documentedSequence": null,
    "documentedIn": null
  },
  "surfaces": {
    "overview": {
      "path": "/dashboard/ops",
      "kpis": [
        {
          "id": "tickets_resolved",
          "label": "Tickets resolved",
          "source": "support_tickets",
          "sourceType": "log",
          "aggregation": "count",
          "defaultTarget": null,
          "computedBy": "code"
        },
        {
          "id": "open_tickets",
          "label": "Open tickets",
          "source": "support_tickets",
          "sourceType": "log",
          "aggregation": "open_count",
          "defaultTarget": null,
          "computedBy": "code"
        },
        {
          "id": "average_satisfaction",
          "label": "Average satisfaction",
          "source": "csat_responses",
          "sourceType": "log",
          "aggregation": "avg",
          "defaultTarget": null,
          "computedBy": "code"
        },
        {
          "id": "tickets_past_response_target",
          "label": "Tickets past response target",
          "source": "support_tickets",
          "sourceType": "log",
          "aggregation": "overdue_count",
          "defaultTarget": null,
          "computedBy": "code"
        }
      ],
      "recommendRules": [
        {
          "id": "urgent_ticket_unanswered_1_hour",
          "when": "urgent ticket unanswered 1 hour",
          "suggest": "escalate",
          "deterministic": true
        },
        {
          "id": "repeat_issue_from_same_customer",
          "when": "repeat issue from same customer",
          "suggest": "root cause",
          "deterministic": true
        }
      ]
    },
    "logs": {
      "path": "/dashboard/ops/logs",
      "entities": [
        {
          "key": "support_tickets",
          "label": "Support tickets",
          "fields": [
            {
              "key": "received_date",
              "type": "date"
            },
            {
              "key": "customer_ref",
              "type": "text"
            },
            {
              "key": "channel",
              "type": "text"
            },
            {
              "key": "priority",
              "type": "enum",
              "values": [
                "low",
                "medium",
                "high",
                "urgent"
              ]
            },
            {
              "key": "resolved_date",
              "type": "date"
            },
            {
              "key": "status",
              "type": "enum",
              "values": [
                "open",
                "pending",
                "resolved"
              ]
            }
          ]
        },
        {
          "key": "csat_responses",
          "label": "Csat responses",
          "fields": [
            {
              "key": "response_date",
              "type": "date"
            },
            {
              "key": "ticket_ref",
              "type": "text"
            },
            {
              "key": "score",
              "type": "number"
            }
          ]
        }
      ]
    },
    "registers": {
      "path": "/dashboard/registers",
      "items": [
        {
          "kind": "Leads",
          "track": [
            "escalations"
          ]
        },
        {
          "kind": "Campaigns",
          "track": [
            "support campaigns"
          ]
        },
        {
          "kind": "Customers",
          "track": [
            "accounts"
          ]
        },
        {
          "kind": "Metrics",
          "track": [
            "support metrics"
          ]
        }
      ]
    },
    "playbooks": {
      "path": "/dashboard/playbooks",
      "seeds": [
        {
          "key": "daily_queue_review",
          "title": "Daily queue review",
          "frequency": "daily",
