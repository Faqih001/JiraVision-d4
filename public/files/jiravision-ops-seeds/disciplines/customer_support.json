        },
        {
          "key": "weekly_quality_review",
          "title": "Weekly quality review",
          "frequency": "weekly",
          "phasesFrom": "method"
        },
        {
          "key": "monthly_trend_report",
          "title": "Monthly trend report",
          "frequency": "monthly",
          "phasesFrom": "method"
        }
