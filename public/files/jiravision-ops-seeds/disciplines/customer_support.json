      "recurringTemplates": [
        {
          "title": "Daily queue review",
          "frequency": "daily",
          "playbookKey": "daily_queue_review"
        },
        {
          "title": "Weekly quality review",
          "frequency": "weekly",
          "playbookKey": "weekly_quality_review"
        },
        {
          "title": "Monthly trend report",
          "frequency": "monthly",
          "playbookKey": "monthly_trend_report"
        }
