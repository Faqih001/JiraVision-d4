  "surfaces": {
    "overview": {
      "path": "/dashboard/ops",
      "kpis": [
        {
          "id": "cost_centres_within_budget",
          "label": "Cost centres within budget",
          "source": "budget_reviews",
          "sourceType": "log",
          "aggregation": "count",
          "defaultTarget": null,
          "computedBy": "code"
        },
        {
          "id": "cost_centres_over_budget",
          "label": "Cost centres over budget",
          "source": "budget_reviews",
          "sourceType": "log",
          "aggregation": "count",
          "defaultTarget": null,
          "computedBy": "code"
        },
        {
          "id": "approvals_pending",
          "label": "Approvals pending",
          "source": "cost_approvals",
          "sourceType": "log",
          "aggregation": "open_count",
          "defaultTarget": null,
          "computedBy": "code"
        },
        {
          "id": "variance_reports",
          "label": "Variance reports",
          "source": "financial_reports",
          "sourceType": "register",
          "aggregation": "count",
          "defaultTarget": null,
          "computedBy": "code"
        }
      ],
      "recommendRules": [
        {
          "id": "cost_centre_over_budget",
          "when": "cost centre over budget",
          "suggest": "explain variance",
          "deterministic": true
        },
        {
          "id": "approval_pending_over_3_days",
          "when": "approval pending over 3 days",
          "suggest": "chase",
          "deterministic": true
        }
      ]
    },
    "logs": {
      "path": "/dashboard/ops/logs",
      "entities": [
        {
          "key": "budget_reviews",
          "label": "Budget reviews",
          "fields": [
            {
              "key": "period",
              "type": "text"
            },
            {
              "key": "cost_centre",
              "type": "text"
            },
            {
              "key": "variance_flag",
              "type": "enum",
              "values": [
                "within",
                "over"
              ]
            },
            {
              "key": "action",
              "type": "text"
            }
          ]
        },
        {
          "key": "cost_approvals",
          "label": "Cost approvals",
          "fields": [
            {
              "key": "request_date",
              "type": "date"
            },
            {
              "key": "item",
              "type": "text"
            },
            {
              "key": "approver",
              "type": "text"
            },
            {
              "key": "status",
              "type": "enum",
              "values": [
                "requested",
                "approved",
                "declined"
              ]
            }
          ]
        }
      ]
    },
