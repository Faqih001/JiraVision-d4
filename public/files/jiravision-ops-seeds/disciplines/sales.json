  "surfaces": {
    "overview": {
      "path": "/dashboard/ops",
      "kpis": [
        {
          "id": "deals_won",
          "label": "Deals won",
          "source": "pipeline_updates",
          "sourceType": "log",
          "aggregation": "count",
          "defaultTarget": null,
          "computedBy": "code"
        },
        {
          "id": "leads_in_pipeline",
          "label": "Leads in pipeline",
          "source": "pipeline_updates",
          "sourceType": "log",
          "aggregation": "open_count",
          "defaultTarget": null,
          "computedBy": "code"
        },
        {
          "id": "calls_logged",
          "label": "Calls logged",
          "source": "sales_calls",
          "sourceType": "log",
          "aggregation": "count",
          "defaultTarget": null,
          "computedBy": "code"
        },
        {
          "id": "follow_ups_overdue",
          "label": "Follow-ups overdue",
          "source": "pipeline_updates",
          "sourceType": "log",
          "aggregation": "overdue_count",
          "defaultTarget": null,
          "computedBy": "code"
        }
      ],
      "recommendRules": [
        {
          "id": "lead_with_no_next_step",
          "when": "lead with no next step",
          "suggest": "set one",
          "deterministic": true
        },
        {
          "id": "proposal_open_over_14_days",
          "when": "proposal open over 14 days",
          "suggest": "follow up",
          "deterministic": true
        }
      ]
    },
    "logs": {
      "path": "/dashboard/ops/logs",
      "entities": [
        {
          "key": "pipeline_updates",
          "label": "Pipeline updates",
          "fields": [
            {
              "key": "update_date",
              "type": "date"
            },
            {
              "key": "lead_ref",
              "type": "text"
            },
            {
              "key": "stage",
              "type": "enum",
              "values": [
                "new",
                "qualified",
                "proposal",
                "won",
                "lost"
              ]
            },
            {
              "key": "next_step_date",
              "type": "date"
            }
          ]
        },
        {
          "key": "sales_calls",
          "label": "Sales calls",
          "fields": [
            {
              "key": "call_date",
              "type": "date"
            },
            {
              "key": "customer_ref",
              "type": "text"
            },
            {
              "key": "outcome",
              "type": "text"
            }
          ]
        }
      ]
    },
    "registers": {
      "path": "/dashboard/registers",
      "items": [
        {
          "kind": "Leads",
