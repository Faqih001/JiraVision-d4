{
  "schemaVersion": 1,
  "discipline": {
    "key": "data_engineering",
    "label": "Data engineer",
    "category": "technology",
    "categoryLabel": "Software, IT & digital",
    "focus": "Pipelines, data quality and platform cost"
  },
  "pack": {
    "key": "developer",
    "reportTemplate": "engineering",
    "registerKinds": [
      "Code repositories",
      "Pull requests",
      "Technical debt",
      "Sprint backlog"
    ],
    "ladderDiscipline": {
      "proposed": "developer",
      "verifyIn": "lib/auto-populate.ts"
    }
  },
  "provenance": {
    "type": "proposed-seed",
    "sourceDocument": null,
    "reviewRequired": true,
    "reviewerRole": "experienced data engineer practitioner",
    "note": "Starting seed written without a source document. Not professional, clinical, legal, financial or safety advice. A practitioner must review before use."
  },
  "method": {
    "resolveAtRuntime": "getMethodForDiscipline(pack, discipline)",
    "documentedSequence": [
      "Extract",
      "Transform",
      "Load",
      "Validate",
      "Optimize",
      "Monitor"
    ],
    "documentedIn": "roles doc section 4.7 (verify in code)"
  },
  "surfaces": {
    "overview": {
      "path": "/dashboard/ops",
      "kpis": [
        {
          "id": "pipeline_success_rate",
          "label": "Pipeline success rate",
          "source": "pipeline_runs",
          "sourceType": "log",
          "aggregation": "rate",
          "defaultTarget": null,
          "computedBy": "code"
        },
        {
          "id": "pipeline_failures",
          "label": "Pipeline failures",
          "source": "pipeline_runs",
          "sourceType": "log",
          "aggregation": "count",
          "defaultTarget": null,
          "computedBy": "code"
        },
        {
          "id": "quality_checks_failed",
          "label": "Quality checks failed",
          "source": "data_quality_checks",
          "sourceType": "log",
          "aggregation": "count",
          "defaultTarget": null,
          "computedBy": "code"
        },
        {
          "id": "debt_items",
          "label": "Debt items",
          "source": "technical_debt",
          "sourceType": "register",
          "aggregation": "count",
          "defaultTarget": null,
          "computedBy": "code"
        }
      ],
      "recommendRules": [
        {
          "id": "pipeline_failed_twice_in_a_week",
          "when": "pipeline failed twice in a week",
          "suggest": "root-cause",
          "deterministic": true
        },
        {
          "id": "quality_check_failing_3_days",
          "when": "quality check failing 3 days",
          "suggest": "fix source",
          "deterministic": true
        }
      ]
    },
    "logs": {
      "path": "/dashboard/ops/logs",
      "entities": [
        {
          "key": "pipeline_runs",
          "label": "Pipeline runs",
          "fields": [
            {
              "key": "run_date",
              "type": "date"
            },
            {
              "key": "pipeline",
              "type": "text"
            },
            {
              "key": "result",
              "type": "enum",
              "values": [
                "success",
                "failed"
              ]
            },
            {
              "key": "rows_processed_count",
              "type": "number"
            },
            {
              "key": "duration_minutes",
              "type": "number"
            }
          ]
        },
        {
          "key": "data_quality_checks",
          "label": "Data quality checks",
          "fields": [
            {
              "key": "check_date",
              "type": "date"
            },
            {
              "key": "dataset",
              "type": "text"
            },
            {
              "key": "check",
              "type": "text"
            },
            {
              "key": "result",
              "type": "enum",
              "values": [
                "pass",
                "fail"
              ]
            }
          ]
        }
      ]
    },
    "registers": {
      "path": "/dashboard/registers",
      "items": [
        {
          "kind": "Code repositories",
          "track": [
            "pipeline code"
          ]
        },
        {
          "kind": "Technical debt",
          "track": [
            "pipeline debt"
          ]
        },
        {
          "kind": "Pull requests",
          "track": [
            "pipeline changes"
          ]
        },
        {
          "kind": "Sprint backlog",
          "track": [
            "data platform work"
          ]
        }
      ]
    },
    "playbooks": {
      "path": "/dashboard/playbooks",
      "seeds": [
        {
          "key": "daily_pipeline_health_check",
          "title": "Daily pipeline health check",
          "frequency": "daily",
          "phasesFrom": "method"
        },
        {
          "key": "weekly_data_quality_review",
          "title": "Weekly data quality review",
          "frequency": "weekly",
          "phasesFrom": "method"
        },
        {
          "key": "monthly_cost_and_storage_review",
          "title": "Monthly cost and storage review",
          "frequency": "monthly",
          "phasesFrom": "method"
        },
        {
          "key": "quarterly_schema_review",
          "title": "Quarterly schema review",
          "frequency": "quarterly",
          "phasesFrom": "method"
        }
      ]
    },
    "tasks": {
      "path": "/dashboard/tasks",
      "recurringTemplates": [
        {
          "title": "Daily pipeline health check",
          "frequency": "daily",
          "playbookKey": "daily_pipeline_health_check"
        },
        {
          "title": "Weekly data quality review",
          "frequency": "weekly",
          "playbookKey": "weekly_data_quality_review"
        },
        {
          "title": "Monthly cost and storage review",
          "frequency": "monthly",
          "playbookKey": "monthly_cost_and_storage_review"
        },
        {
          "title": "Quarterly schema review",
          "frequency": "quarterly",
          "playbookKey": "quarterly_schema_review"
        }
      ]
    },
    "reports": {
      "path": "/dashboard/reports-work",
      "template": "engineering",
      "cadences": [
        "daily",
        "weekly",
        "monthly"
      ],
      "sections": [
        "Summary",
        "Pipeline success rate",
        "Pipeline failures",
        "Quality checks failed",
        "Debt items",
        "Risks and recommendations",
        "Plan for next period"
      ]
    }
  },
  "ai": {
    "policy": {
      "level": "standard",
      "neverSendRegisterKinds": [],
      "neverSendEntities": [],
      "neverSendFields": [
        "passwords",
        "keys",
        "tokens",
        "personal identifiers"
      ],
      "numbers": "never produced or altered by the model; computed in code"
    },
    "agents": [
      {
        "id": "G0",
        "page": "/onboarding",
        "flavour": "classify an unmapped job title into this discipline (enum-validated; deterministic map wins)"
      },
      {
        "id": "G1",
        "page": "/dashboard/agent",
        "flavour": "extract register rows and playbook drafts for Data engineer from a pasted procedure or handover"
      },
      {
        "id": "G2",
        "page": "/dashboard/tasks",
        "flavour": "triage a free-text request into task fields"
      },
      {
        "id": "G3",
        "page": "/dashboard/worklog",
        "flavour": "turn rough notes into work-log entries tagged to a method phase"
      },
      {
        "id": "G4",
        "page": "/dashboard/ops/logs",
        "flavour": "read pasted text into: pipeline_runs, data_quality_checks"
      },
      {
        "id": "G5",
        "page": "/dashboard/reports-work",
        "flavour": "draft summary and recommendation text only; numbers come from the server"
      },
      {
        "id": "G6",
        "page": "/dashboard/automation",
        "flavour": "draft rules from plain language; dry-run before enabling"
      },
      {
        "id": "G8",
        "page": "/dashboard/ops",
        "flavour": "turn deterministic rule facts into recommendation text"
      },
      {
        "id": "G11",
        "page": "/dashboard/playbooks",
        "flavour": "draft playbook phases from procedure text using the Data engineer method"
      }
