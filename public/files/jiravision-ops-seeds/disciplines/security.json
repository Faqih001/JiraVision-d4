{
  "schemaVersion": 1,
  "discipline": {
    "key": "security",
    "label": "Security",
    "category": "technology",
    "categoryLabel": "Software, IT & digital",
    "focus": "Detection, response and access review"
  },
  "pack": {
    "key": "it-technician",
    "reportTemplate": "technical",
    "registerKinds": [
      "Infrastructure",
      "Accounts and systems",
      "Equipment",
      "Outstanding work"
    ],
    "ladderDiscipline": {
      "proposed": "technician",
      "verifyIn": "lib/auto-populate.ts"
    }
  },
  "provenance": {
    "type": "proposed-seed",
    "sourceDocument": null,
    "reviewRequired": true,
    "reviewerRole": "experienced security practitioner",
    "note": "Starting seed written without a source document. Not professional, clinical, legal, financial or safety advice. A practitioner must review before use."
  },
  "method": {
    "resolveAtRuntime": "getMethodForDiscipline(pack, discipline)",
    "documentedSequence": [
      "Assess",
      "Detect",
      "Contain",
      "Eradicate",
      "Recover",
      "Review"
    ],
    "documentedIn": "roles doc section 4.7 (verify in code)"
  },
  "surfaces": {
    "overview": {
      "path": "/dashboard/ops",
      "kpis": [
        {
          "id": "events_closed",
          "label": "Events closed",
          "source": "security_events",
          "sourceType": "log",
          "aggregation": "count",
          "defaultTarget": null,
          "computedBy": "code"
        },
        {
          "id": "critical_events_open",
          "label": "Critical events open",
          "source": "security_events",
          "sourceType": "log",
          "aggregation": "open_count",
          "defaultTarget": null,
          "computedBy": "code"
        },
        {
          "id": "access_reviews_done",
          "label": "Access reviews done",
          "source": "access_reviews",
          "sourceType": "log",
          "aggregation": "count",
          "defaultTarget": null,
          "computedBy": "code"
        },
        {
          "id": "reviews_needing_changes",
          "label": "Reviews needing changes",
          "source": "access_reviews",
          "sourceType": "log",
          "aggregation": "count",
          "defaultTarget": null,
          "computedBy": "code"
        }
      ],
      "recommendRules": [
        {
          "id": "critical_event_uncontained_over_4_hours",
          "when": "critical event uncontained over 4 hours",
          "suggest": "escalate",
          "deterministic": true
        },
        {
          "id": "system_not_access_reviewed_in_90_days",
          "when": "system not access-reviewed in 90 days",
          "suggest": "review",
          "deterministic": true
        }
      ]
    },
    "logs": {
      "path": "/dashboard/ops/logs",
      "entities": [
        {
          "key": "security_events",
          "label": "Security events",
          "fields": [
            {
              "key": "event_date",
              "type": "date"
            },
            {
              "key": "type",
              "type": "text"
            },
            {
              "key": "severity",
              "type": "enum",
              "values": [
                "low",
                "medium",
                "high",
                "critical"
              ]
            },
            {
              "key": "contained_date",
              "type": "date"
            },
            {
              "key": "status",
              "type": "enum",
              "values": [
                "open",
                "contained",
                "closed"
              ]
            }
          ]
        },
        {
          "key": "access_reviews",
          "label": "Access reviews",
          "fields": [
            {
              "key": "review_date",
              "type": "date"
            },
            {
              "key": "system",
              "type": "text"
            },
            {
              "key": "result",
              "type": "enum",
              "values": [
                "ok",
                "changes_needed"
              ]
            }
          ]
        }
      ]
    },
    "registers": {
      "path": "/dashboard/registers",
      "items": [
        {
          "kind": "Infrastructure",
          "track": [
            "protected systems"
          ]
        },
        {
          "kind": "Accounts and systems",
          "track": [
            "security tools (references only; never credentials)"
