          "label": "Follow-ups open",
          "source": "beneficiary_followups",
          "sourceType": "log",
          "aggregation": "open_count",
          "defaultTarget": null,
          "computedBy": "code"
        },
        {
          "id": "open_actions",
          "label": "Open actions",
          "source": "outstanding_work",
