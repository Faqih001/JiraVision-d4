{
  "schemaVersion": 1,
  "discipline": {
    "key": "human_resources",
    "label": "Human resources",
    "category": "people",
    "categoryLabel": "People, administration & governance",
    "focus": "Recruitment, onboarding and records"
  },
  "pack": {
    "key": "hr",
    "reportTemplate": "general",
    "registerKinds": [
      "Employee records",
      "Policies",
      "Training",
      "Compliance"
    ],
    "ladderDiscipline": {
      "proposed": "hr",
      "verifyIn": "lib/auto-populate.ts"
    }
  },
  "provenance": {
    "type": "proposed-seed",
    "sourceDocument": null,
    "reviewRequired": true,
    "reviewerRole": "experienced human resources practitioner",
    "note": "Starting seed written without a source document. Not professional, clinical, legal, financial or safety advice. A practitioner must review before use."
  },
  "method": {
    "resolveAtRuntime": "getMethodForDiscipline(pack, discipline)",
    "documentedSequence": null,
    "documentedIn": null
  },
  "surfaces": {
    "overview": {
      "path": "/dashboard/ops",
      "kpis": [
        {
          "id": "roles_filled",
          "label": "Roles filled",
          "source": "recruitment_pipeline",
          "sourceType": "log",
          "aggregation": "count",
          "defaultTarget": null,
          "computedBy": "code"
        },
        {
          "id": "roles_open",
          "label": "Roles open",
          "source": "recruitment_pipeline",
          "sourceType": "log",
          "aggregation": "open_count",
          "defaultTarget": null,
          "computedBy": "code"
        },
        {
          "id": "onboardings_completed",
          "label": "Onboardings completed",
          "source": "onboarding_checks",
          "sourceType": "log",
          "aggregation": "count",
          "defaultTarget": null,
          "computedBy": "code"
        },
        {
          "id": "policies_reviewed",
          "label": "Policies reviewed",
          "source": "policies",
          "sourceType": "register",
          "aggregation": "count",
          "defaultTarget": null,
          "computedBy": "code"
        }
      ],
      "recommendRules": [
        {
          "id": "role_open_over_60_days",
          "when": "role open over 60 days",
          "suggest": "review process",
          "deterministic": true
        },
        {
          "id": "onboarding_checklist_incomplete_after_14_days",
          "when": "onboarding checklist incomplete after 14 days",
          "suggest": "complete",
          "deterministic": true
        }
      ]
    },
    "logs": {
      "path": "/dashboard/ops/logs",
      "entities": [
        {
          "key": "recruitment_pipeline",
          "label": "Recruitment pipeline",
          "fields": [
            {
              "key": "role_ref",
              "type": "text"
            },
            {
              "key": "stage",
              "type": "enum",
              "values": [
                "open",
                "screening",
                "interview",
                "offer",
                "filled"
              ]
            },
            {
              "key": "opened_date",
              "type": "date"
            },
            {
              "key": "filled_date",
              "type": "date"
            }
          ]
        },
        {
          "key": "onboarding_checks",
          "label": "Onboarding checks",
          "fields": [
            {
              "key": "start_date",
              "type": "date"
            },
            {
              "key": "employee_ref",
              "type": "text"
            },
            {
              "key": "checklist_complete",
              "type": "enum",
              "values": [
                "yes",
                "no"
              ]
            }
          ]
        }
      ]
    },
    "registers": {
      "path": "/dashboard/registers",
      "items": [
        {
          "kind": "Employee records",
          "track": [
            "records held (codes only)"
          ]
        },
        {
          "kind": "Policies",
          "track": [
            "HR policies"
          ]
        },
        {
          "kind": "Training",
          "track": [
            "mandatory training"
          ]
        },
        {
          "kind": "Compliance",
          "track": [
            "employment compliance"
          ]
        }
      ]
    },
    "playbooks": {
      "path": "/dashboard/playbooks",
      "seeds": [
        {
          "key": "weekly_recruitment_review",
          "title": "Weekly recruitment review",
          "frequency": "weekly",
          "phasesFrom": "method"
        },
        {
          "key": "onboarding_checklist",
          "title": "Onboarding checklist",
          "frequency": "as_needed",
          "phasesFrom": "method"
        },
        {
          "key": "monthly_hr_report",
          "title": "Monthly HR report",
          "frequency": "monthly",
          "phasesFrom": "method"
        },
        {
          "key": "annual_policy_review",
          "title": "Annual policy review",
          "frequency": "quarterly",
          "phasesFrom": "method"
        }
      ]
    },
    "tasks": {
      "path": "/dashboard/tasks",
      "recurringTemplates": [
        {
          "title": "Weekly recruitment review",
          "frequency": "weekly",
          "playbookKey": "weekly_recruitment_review"
        },
        {
          "title": "Monthly HR report",
          "frequency": "monthly",
          "playbookKey": "monthly_hr_report"
        },
        {
          "title": "Annual policy review",
          "frequency": "quarterly",
          "playbookKey": "annual_policy_review"
        }
      ]
    },
    "reports": {
      "path": "/dashboard/reports-work",
      "template": "general",
      "cadences": [
        "daily",
        "weekly",
        "monthly"
      ],
      "sections": [
        "Summary",
        "Roles filled",
        "Roles open",
        "Onboardings completed",
        "Policies reviewed",
        "Risks and recommendations",
        "Plan for next period"
      ]
    }
  },
  "ai": {
    "policy": {
      "level": "restricted",
      "neverSendRegisterKinds": [
        "Employee records"
      ],
      "neverSendEntities": [
        "recruitment_pipeline",
        "onboarding_checks"
      ],
      "neverSendFields": [
        "passwords",
        "keys",
        "tokens",
        "personal identifiers",
        "amounts and balances"
      ],
      "numbers": "never produced or altered by the model; computed in code"
    },
    "agents": [
      {
        "id": "G0",
        "page": "/onboarding",
        "flavour": "classify an unmapped job title into this discipline (enum-validated; deterministic map wins)"
      },
      {
        "id": "G1",
        "page": "/dashboard/agent",
        "flavour": "extract register rows and playbook drafts for Human resources from a pasted procedure or handover"
      },
      {
        "id": "G2",
        "page": "/dashboard/tasks",
        "flavour": "triage a free-text request into task fields"
      },
      {
        "id": "G3",
        "page": "/dashboard/worklog",
        "flavour": "turn rough notes into work-log entries tagged to a method phase"
      },
      {
        "id": "G5",
        "page": "/dashboard/reports-work",
        "flavour": "draft summary and recommendation text only; numbers come from the server"
      },
      {
        "id": "G6",
        "page": "/dashboard/automation",
        "flavour": "draft rules from plain language; dry-run before enabling"
      },
      {
        "id": "G8",
        "page": "/dashboard/ops",
        "flavour": "turn deterministic rule facts into recommendation text"
      },
      {
        "id": "G11",
        "page": "/dashboard/playbooks",
        "flavour": "draft playbook phases from procedure text using the Human resources method"
      }
    ]
  },
  "needsConfirmation": [
    "KPI targets are unset (defaultTarget null): the owner and their manager must set them.",
    "Field names, enums and playbook titles are proposals: confirm against local practice."
  ]
}