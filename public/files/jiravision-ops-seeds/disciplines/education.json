{
  "schemaVersion": 1,
  "discipline": {
    "key": "education",
    "label": "Education",
    "category": "science",
    "categoryLabel": "Health, science & specialist services",
    "focus": "Lesson planning, assessment and learner progress"
  },
  "pack": {
    "key": "healthcare-science",
    "reportTemplate": "technical",
    "registerKinds": [
      "Patients",
      "Clinical protocols",
      "Research",
      "Compliance"
    ],
    "ladderDiscipline": {
      "proposed": "healthcare_science",
      "verifyIn": "lib/auto-populate.ts"
    }
  },
  "provenance": {
    "type": "proposed-seed",
    "sourceDocument": null,
    "reviewRequired": true,
    "reviewerRole": "qualified teacher",
    "note": "Starting seed written without a source document. Not professional, clinical, legal, financial or safety advice. A practitioner must review before use."
  },
  "method": {
    "resolveAtRuntime": "getMethodForDiscipline(pack, discipline)",
    "documentedSequence": null,
    "documentedIn": null
  },
  "surfaces": {
    "overview": {
      "path": "/dashboard/ops",
      "kpis": [
        {
          "id": "lessons_taught",
          "label": "Lessons taught",
          "source": "lesson_plans",
          "sourceType": "log",
          "aggregation": "count",
          "defaultTarget": null,
          "computedBy": "code"
        },
        {
          "id": "assessments_complete",
          "label": "Assessments complete",
          "source": "assessment_records",
          "sourceType": "log",
          "aggregation": "count",
          "defaultTarget": null,
          "computedBy": "code"
        },
        {
          "id": "lessons_planned_not_taught",
          "label": "Lessons planned not taught",
          "source": "lesson_plans",
          "sourceType": "log",
          "aggregation": "open_count",
          "defaultTarget": null,
          "computedBy": "code"
        },
        {
          "id": "safeguarding_items",
          "label": "Safeguarding items",
          "source": "compliance",
          "sourceType": "register",
          "aggregation": "count",
          "defaultTarget": null,
          "computedBy": "code"
        }
      ],
      "recommendRules": [
        {
          "id": "lesson_planned_but_not_taught",
          "when": "lesson planned but not taught",
          "suggest": "reschedule",
          "deterministic": true
        },
        {
          "id": "assessment_partly_complete",
          "when": "assessment partly complete",
          "suggest": "finish",
          "deterministic": true
        }
      ]
    },
    "logs": {
      "path": "/dashboard/ops/logs",
      "entities": [
        {
          "key": "lesson_plans",
          "label": "Lesson plans",
          "fields": [
            {
              "key": "lesson_date",
              "type": "date"
            },
            {
              "key": "class",
              "type": "text"
            },
            {
              "key": "topic",
              "type": "text"
            },
            {
              "key": "status",
              "type": "enum",
              "values": [
                "planned",
                "taught"
              ]
            }
          ]
        },
        {
          "key": "assessment_records",
          "label": "Assessment records",
          "fields": [
            {
              "key": "assessment_date",
              "type": "date"
            },
            {
              "key": "class",
              "type": "text"
            },
            {
              "key": "assessment",
              "type": "text"
            },
            {
              "key": "completion_status",
              "type": "enum",
              "values": [
                "complete",
                "partial"
              ]
            }
          ]
        }
      ]
    },
    "registers": {
      "path": "/dashboard/registers",
      "items": [
        {
          "kind": "Patients",
          "track": [
            "none"
          ]
        },
        {
          "kind": "Clinical protocols",
          "track": [
            "teaching protocols"
          ]
        },
        {
          "kind": "Research",
          "track": [
            "pedagogy research"
          ]
        },
        {
          "kind": "Compliance",
          "track": [
            "curriculum and safeguarding"
          ]
        }
      ]
    },
    "playbooks": {
      "path": "/dashboard/playbooks",
      "seeds": [
        {
          "key": "daily_lesson_plan",
          "title": "Daily lesson plan",
          "frequency": "daily",
          "phasesFrom": "method"
        },
        {
          "key": "weekly_assessment_review",
          "title": "Weekly assessment review",
          "frequency": "weekly",
          "phasesFrom": "method"
        },
        {
