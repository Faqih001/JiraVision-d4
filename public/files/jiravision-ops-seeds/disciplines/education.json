          "title": "Monthly progress report",
          "frequency": "monthly",
          "phasesFrom": "method"
        },
        {
          "key": "term_curriculum_review",
          "title": "Term curriculum review",
          "frequency": "quarterly",
          "phasesFrom": "method"
        }
