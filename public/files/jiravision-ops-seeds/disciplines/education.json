    },
    "tasks": {
      "path": "/dashboard/tasks",
      "recurringTemplates": [
        {
          "title": "Daily lesson plan",
          "frequency": "daily",
          "playbookKey": "daily_lesson_plan"
        },
        {
          "title": "Weekly assessment review",
          "frequency": "weekly",
          "playbookKey": "weekly_assessment_review"
        },
        {
          "title": "Monthly progress report",
          "frequency": "monthly",
          "playbookKey": "monthly_progress_report"
        },
        {
          "title": "Term curriculum review",
          "frequency": "quarterly",
          "playbookKey": "term_curriculum_review"
