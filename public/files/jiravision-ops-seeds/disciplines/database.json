                "success",
                "warning",
                "failed"
              ]
            },
            {
              "key": "size_gb",
              "type": "text"
            }
          ]
        },
        {
          "key": "restore_tests",
          "label": "Restore tests",
          "fields": [
            {
              "key": "test_date",
              "type": "date"
            },
            {
              "key": "database",
              "type": "text"
            },
            {
              "key": "backup_date_restored",
              "type": "text"
            },
            {
              "key": "result",
