        {
          "id": "backup_success_rate",
          "label": "Backup success rate",
          "source": "backup_runs",
          "sourceType": "log",
          "aggregation": "rate",
          "defaultTarget": null,
          "computedBy": "code"
        },
        {
          "id": "backup_failures",
          "label": "Backup failures",
          "source": "backup_runs",
          "sourceType": "log",
          "aggregation": "count",
          "defaultTarget": null,
          "computedBy": "code"
        },
        {
          "id": "restore_tests_passed",
          "label": "Restore tests passed",
          "source": "restore_tests",
          "sourceType": "log",
          "aggregation": "count",
          "defaultTarget": null,
          "computedBy": "code"
        },
        {
          "id": "databases_tracked",
          "label": "Databases tracked",
          "source": "infrastructure",
          "sourceType": "register",
          "aggregation": "count",
          "defaultTarget": null,
          "computedBy": "code"
        }
      ],
      "recommendRules": [
        {
          "id": "no_successful_backup_in_24_hours",
          "when": "no successful backup in 24 hours",
          "suggest": "investigate",
          "deterministic": true
        },
        {
          "id": "no_restore_test_in_30_days",
          "when": "no restore test in 30 days",
          "suggest": "schedule one",
          "deterministic": true
        }
      ]
    },
