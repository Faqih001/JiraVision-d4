          "defaultTarget": null,
          "computedBy": "code"
        },
        {
          "id": "major_variances",
          "label": "Major variances",
          "source": "stock_counts",
          "sourceType": "log",
          "aggregation": "count",
          "defaultTarget": null,
          "computedBy": "code"
        },
        {
          "id": "reorders_pending",
