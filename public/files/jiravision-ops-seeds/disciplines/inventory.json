      ],
      "recommendRules": [
        {
          "id": "item_at_reorder_level",
          "when": "item at reorder level",
          "suggest": "raise order",
          "deterministic": true
        },
        {
          "id": "major_variance",
          "when": "major variance",
          "suggest": "recount",
          "deterministic": true
        }
      ]
    },
