{
  "schemaVersion": 1,
  "discipline": {
    "key": "researcher",
    "label": "Researcher",
    "category": "information",
    "categoryLabel": "Analysis, research & information",
    "focus": "Literature, methods and research outputs"
  },
  "pack": {
    "key": "analyst",
    "reportTemplate": "assurance",
    "registerKinds": [
      "Data sources",
      "Analysis reports",
      "Dashboards",
      "Methodology"
    ],
    "ladderDiscipline": {
      "proposed": "analyst",
      "verifyIn": "lib/auto-populate.ts"
    }
  },
  "provenance": {
    "type": "proposed-seed",
    "sourceDocument": null,
    "reviewRequired": true,
    "reviewerRole": "experienced researcher practitioner",
    "note": "Starting seed written without a source document. Not professional, clinical, legal, financial or safety advice. A practitioner must review before use."
  },
  "method": {
    "resolveAtRuntime": "getMethodForDiscipline(pack, discipline)",
    "documentedSequence": null,
    "documentedIn": null
  },
  "surfaces": {
    "overview": {
      "path": "/dashboard/ops",
      "kpis": [
        {
          "id": "milestones_met",
          "label": "Milestones met",
          "source": "research_milestones",
          "sourceType": "log",
          "aggregation": "count",
          "defaultTarget": null,
          "computedBy": "code"
        },
        {
          "id": "milestones_missed",
          "label": "Milestones missed",
          "source": "research_milestones",
          "sourceType": "log",
          "aggregation": "count",
          "defaultTarget": null,
          "computedBy": "code"
        },
        {
          "id": "reviews_finalised",
          "label": "Reviews finalised",
          "source": "literature_reviews",
          "sourceType": "log",
          "aggregation": "count",
          "defaultTarget": null,
          "computedBy": "code"
        },
        {
          "id": "outputs_recorded",
          "label": "Outputs recorded",
          "source": "analysis_reports",
          "sourceType": "register",
          "aggregation": "count",
          "defaultTarget": null,
          "computedBy": "code"
        }
      ],
      "recommendRules": [
        {
          "id": "milestone_missed",
          "when": "milestone missed",
          "suggest": "replan",
          "deterministic": true
        },
        {
          "id": "ethics_approval_expiring_in_30_days",
          "when": "ethics approval expiring in 30 days",
          "suggest": "renew",
          "deterministic": true
        }
      ]
    },
    "logs": {
      "path": "/dashboard/ops/logs",
      "entities": [
        {
          "key": "literature_reviews",
          "label": "Literature reviews",
          "fields": [
            {
              "key": "review_date",
              "type": "date"
            },
            {
              "key": "topic",
              "type": "text"
            },
            {
              "key": "sources_reviewed_count",
              "type": "number"
            },
            {
              "key": "summary_status",
              "type": "enum",
              "values": [
                "draft",
                "final"
              ]
            }
          ]
        },
        {
          "key": "research_milestones",
          "label": "Research milestones",
          "fields": [
            {
              "key": "milestone",
              "type": "text"
            },
            {
              "key": "planned_date",
              "type": "date"
            },
            {
              "key": "actual_date",
              "type": "date"
            },
            {
              "key": "status",
              "type": "enum",
              "values": [
                "planned",
                "met",
                "missed"
              ]
            }
          ]
        }
      ]
    },
    "registers": {
      "path": "/dashboard/registers",
      "items": [
        {
          "kind": "Analysis reports",
          "track": [
            "research outputs"
          ]
        },
        {
          "kind": "Methodology",
          "track": [
            "methods and ethics approvals"
          ]
        },
        {
          "kind": "Data sources",
          "track": [
            "datasets and literature"
          ]
        }
      ]
    },
    "playbooks": {
      "path": "/dashboard/playbooks",
      "seeds": [
        {
          "key": "weekly_literature_review",
          "title": "Weekly literature review",
          "frequency": "weekly",
          "phasesFrom": "method"
        },
        {
          "key": "monthly_milestone_check",
          "title": "Monthly milestone check",
          "frequency": "monthly",
          "phasesFrom": "method"
        },
        {
          "key": "quarterly_output_review",
          "title": "Quarterly output review",
          "frequency": "quarterly",
          "phasesFrom": "method"
        }
      ]
    },
    "tasks": {
      "path": "/dashboard/tasks",
      "recurringTemplates": [
        {
          "title": "Weekly literature review",
          "frequency": "weekly",
          "playbookKey": "weekly_literature_review"
        },
        {
          "title": "Monthly milestone check",
          "frequency": "monthly",
          "playbookKey": "monthly_milestone_check"
        },
        {
          "title": "Quarterly output review",
          "frequency": "quarterly",
          "playbookKey": "quarterly_output_review"
        }
      ]
    },
    "reports": {
      "path": "/dashboard/reports-work",
      "template": "assurance",
      "cadences": [
        "daily",
        "weekly",
        "monthly"
      ],
      "sections": [
        "Summary",
        "Milestones met",
        "Milestones missed",
        "Reviews finalised",
        "Outputs recorded",
        "Risks and recommendations",
        "Plan for next period"
      ]
    }
  },
  "ai": {
    "policy": {
      "level": "standard",
      "neverSendRegisterKinds": [],
      "neverSendEntities": [],
      "neverSendFields": [
        "passwords",
        "keys",
        "tokens",
        "personal identifiers"
      ],
      "numbers": "never produced or altered by the model; computed in code"
    },
    "agents": [
      {
        "id": "G0",
        "page": "/onboarding",
        "flavour": "classify an unmapped job title into this discipline (enum-validated; deterministic map wins)"
      },
      {
        "id": "G1",
        "page": "/dashboard/agent",
        "flavour": "extract register rows and playbook drafts for Researcher from a pasted procedure or handover"
      },
      {
        "id": "G2",
        "page": "/dashboard/tasks",
        "flavour": "triage a free-text request into task fields"
      },
      {
        "id": "G3",
        "page": "/dashboard/worklog",
        "flavour": "turn rough notes into work-log entries tagged to a method phase"
      },
      {
        "id": "G4",
        "page": "/dashboard/ops/logs",
        "flavour": "read pasted text into: literature_reviews, research_milestones"
      },
      {
        "id": "G5",
        "page": "/dashboard/reports-work",
        "flavour": "draft summary and recommendation text only; numbers come from the server"
      },
      {
        "id": "G6",
        "page": "/dashboard/automation",
        "flavour": "draft rules from plain language; dry-run before enabling"
      },
      {
        "id": "G8",
        "page": "/dashboard/ops",
        "flavour": "turn deterministic rule facts into recommendation text"
      },
      {
        "id": "G11",
        "page": "/dashboard/playbooks",
        "flavour": "draft playbook phases from procedure text using the Researcher method"
      }
    ]
  },
  "needsConfirmation": [
    "KPI targets are unset (defaultTarget null): the owner and their manager must set them.",
    "Field names, enums and playbook titles are proposals: confirm against local practice."
  ]
}