        {
          "id": "risks_open",
          "label": "Risks open",
          "source": "risk_assessments",
          "sourceType": "log",
          "aggregation": "open_count",
          "defaultTarget": null,
          "computedBy": "code"
        },
        {
          "id": "controls_ineffective",
          "label": "Controls ineffective",
          "source": "control_tests",
          "sourceType": "log",
          "aggregation": "count",
          "defaultTarget": null,
          "computedBy": "code"
        },
        {
          "id": "controls_tested",
          "label": "Controls tested",
          "source": "control_tests",
          "sourceType": "log",
          "aggregation": "count",
          "defaultTarget": null,
          "computedBy": "code"
        }
      ],
      "recommendRules": [
        {
          "id": "high_risk_without_owner",
          "when": "high risk without owner",
          "suggest": "assign",
          "deterministic": true
        },
        {
          "id": "control_ineffective",
          "when": "control ineffective",
          "suggest": "remediate",
          "deterministic": true
        }
      ]
    },
