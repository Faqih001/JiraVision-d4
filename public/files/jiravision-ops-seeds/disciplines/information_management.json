  "surfaces": {
    "overview": {
      "path": "/dashboard/ops",
      "kpis": [
        {
          "id": "records_reviews_done",
          "label": "Records reviews done",
          "source": "records_reviews",
          "sourceType": "log",
          "aggregation": "count",
          "defaultTarget": null,
          "computedBy": "code"
        },
        {
          "id": "access_requests_pending",
          "label": "Access requests pending",
          "source": "access_requests",
          "sourceType": "log",
          "aggregation": "open_count",
          "defaultTarget": null,
          "computedBy": "code"
        },
        {
          "id": "requests_decided",
          "label": "Requests decided",
          "source": "access_requests",
          "sourceType": "log",
          "aggregation": "count",
          "defaultTarget": null,
          "computedBy": "code"
        },
        {
          "id": "information_assets_listed",
          "label": "Information assets listed",
          "source": "data_sources",
          "sourceType": "register",
          "aggregation": "count",
          "defaultTarget": null,
          "computedBy": "code"
        }
      ],
      "recommendRules": [
        {
          "id": "access_request_pending_over_3_days",
          "when": "access request pending over 3 days",
          "suggest": "decide",
          "deterministic": true
        },
        {
          "id": "collection_not_reviewed_in_12_months",
          "when": "collection not reviewed in 12 months",
          "suggest": "review",
          "deterministic": true
        }
      ]
    },
    "logs": {
      "path": "/dashboard/ops/logs",
      "entities": [
        {
          "key": "records_reviews",
          "label": "Records reviews",
          "fields": [
            {
              "key": "review_date",
              "type": "date"
            },
            {
              "key": "collection",
              "type": "text"
            },
            {
              "key": "retention_action",
              "type": "enum",
              "values": [
                "keep",
                "archive",
                "dispose"
              ]
            }
          ]
        },
        {
          "key": "access_requests",
          "label": "Access requests",
          "fields": [
            {
              "key": "received_date",
              "type": "date"
            },
            {
              "key": "requester",
              "type": "text"
            },
            {
              "key": "resource",
              "type": "text"
            },
            {
              "key": "status",
              "type": "enum",
              "values": [
                "pending",
                "granted",
                "denied"
              ]
            }
          ]
        }
      ]
    },
    "registers": {
      "path": "/dashboard/registers",
      "items": [
