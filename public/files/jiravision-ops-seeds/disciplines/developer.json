{
  "schemaVersion": 1,
  "discipline": {
    "key": "developer",
    "label": "Developer",
    "category": "technology",
    "categoryLabel": "Software, IT & digital",
    "focus": "Build, review, release and maintain software"
  },
  "pack": {
    "key": "developer",
    "reportTemplate": "engineering",
    "registerKinds": [
      "Code repositories",
      "Pull requests",
      "Technical debt",
      "Sprint backlog"
    ],
    "ladderDiscipline": {
      "proposed": "developer",
      "verifyIn": "lib/auto-populate.ts"
    }
  },
  "provenance": {
    "type": "proposed-seed",
    "sourceDocument": null,
    "reviewRequired": true,
    "reviewerRole": "experienced developer practitioner",
    "note": "Starting seed written without a source document. Not professional, clinical, legal, financial or safety advice. A practitioner must review before use."
  },
  "method": {
    "resolveAtRuntime": "getMethodForDiscipline(pack, discipline)",
    "documentedSequence": [
      "Plan",
      "Code",
      "Review",
      "Test",
      "Deploy",
      "Monitor"
    ],
    "documentedIn": "roles doc section 4.7 (verify in code)"
  },
  "surfaces": {
    "overview": {
      "path": "/dashboard/ops",
      "kpis": [
        {
          "id": "release_success_rate",
          "label": "Release success rate",
          "source": "releases",
          "sourceType": "log",
          "aggregation": "rate",
          "defaultTarget": null,
          "computedBy": "code"
        },
        {
          "id": "escaped_defects",
          "label": "Escaped defects",
          "source": "defects",
          "sourceType": "log",
          "aggregation": "count",
          "defaultTarget": null,
          "computedBy": "code"
        },
        {
          "id": "open_critical_defects",
          "label": "Open critical defects",
          "source": "defects",
          "sourceType": "log",
          "aggregation": "open_count",
          "defaultTarget": null,
          "computedBy": "code"
        },
        {
          "id": "technical_debt_items",
          "label": "Technical debt items",
          "source": "technical_debt",
          "sourceType": "register",
          "aggregation": "count",
          "defaultTarget": null,
          "computedBy": "code"
        }
      ],
      "recommendRules": [
        {
          "id": "pr_open_over_3_days",
          "when": "PR open over 3 days",
          "suggest": "nudge reviewer",
          "deterministic": true
        },
        {
          "id": "release_rolled_back",
          "when": "release rolled back",
          "suggest": "add post-mortem",
          "deterministic": true
        },
        {
          "id": "repo_without_ci_status",
          "when": "repo without CI status",
          "suggest": "record",
          "deterministic": true
        }
      ]
    },
    "logs": {
      "path": "/dashboard/ops/logs",
      "entities": [
        {
          "key": "releases",
          "label": "Releases",
          "fields": [
            {
              "key": "release_date",
              "type": "date"
            },
            {
              "key": "version",
              "type": "text"
            },
            {
              "key": "environment",
              "type": "enum",
              "values": [
                "dev",
                "staging",
                "production"
              ]
            },
            {
              "key": "result",
              "type": "enum",
              "values": [
                "success",
                "failed",
                "rolled_back"
              ]
            },
            {
              "key": "rollback_reason",
              "type": "text"
            }
          ]
        },
        {
          "key": "defects",
          "label": "Defects",
          "fields": [
            {
              "key": "found_date",
              "type": "date"
            },
            {
              "key": "severity",
              "type": "enum",
              "values": [
                "low",
                "medium",
                "high",
                "critical"
              ]
            },
            {
              "key": "escaped",
              "type": "enum",
              "values": [
                "yes",
                "no"
              ]
            },
            {
              "key": "status",
              "type": "enum",
              "values": [
                "open",
                "fixed",
                "wont_fix"
              ]
            },
            {
              "key": "fixed_date",
              "type": "date"
            }
          ]
        }
      ]
    },
    "registers": {
      "path": "/dashboard/registers",
      "items": [
        {
          "kind": "Code repositories",
          "track": [
            "repo owner",
            "default branch",
            "CI status"
          ]
        },
        {
          "kind": "Pull requests",
          "track": [
            "open PRs",
            "reviewers"
          ]
        },
        {
          "kind": "Technical debt",
          "track": [
            "debt items",
            "impact"
          ]
        },
        {
          "kind": "Sprint backlog",
          "track": [
            "sprint items"
          ]
        }
      ]
    },
    "playbooks": {
      "path": "/dashboard/playbooks",
      "seeds": [
        {
          "key": "daily_code_review",
          "title": "Daily code review",
          "frequency": "daily",
          "phasesFrom": "method"
        },
        {
          "key": "release_checklist",
          "title": "Release checklist",
          "frequency": "weekly",
          "phasesFrom": "method"
        },
        {
          "key": "dependency_and_security_update",
          "title": "Dependency and security update",
          "frequency": "monthly",
          "phasesFrom": "method"
        },
        {
          "key": "technical_debt_review",
          "title": "Technical debt review",
          "frequency": "monthly",
          "phasesFrom": "method"
        }
      ]
    },
    "tasks": {
      "path": "/dashboard/tasks",
      "recurringTemplates": [
        {
          "title": "Daily code review",
          "frequency": "daily",
          "playbookKey": "daily_code_review"
        },
        {
          "title": "Release checklist",
          "frequency": "weekly",
          "playbookKey": "release_checklist"
        },
        {
          "title": "Dependency and security update",
          "frequency": "monthly",
          "playbookKey": "dependency_and_security_update"
        },
        {
          "title": "Technical debt review",
          "frequency": "monthly",
          "playbookKey": "technical_debt_review"
        }
      ]
    },
    "reports": {
      "path": "/dashboard/reports-work",
      "template": "engineering",
      "cadences": [
        "daily",
        "weekly",
        "monthly"
      ],
      "sections": [
        "Summary",
        "Release success rate",
        "Escaped defects",
        "Open critical defects",
        "Technical debt items",
        "Risks and recommendations",
        "Plan for next period"
      ]
    }
  },
  "ai": {
    "policy": {
      "level": "standard",
      "neverSendRegisterKinds": [],
      "neverSendEntities": [],
      "neverSendFields": [
        "passwords",
        "keys",
        "tokens",
        "personal identifiers"
      ],
      "numbers": "never produced or altered by the model; computed in code"
    },
    "agents": [
      {
        "id": "G0",
        "page": "/onboarding",
        "flavour": "classify an unmapped job title into this discipline (enum-validated; deterministic map wins)"
      },
      {
        "id": "G1",
        "page": "/dashboard/agent",
        "flavour": "extract register rows and playbook drafts for Developer from a pasted procedure or handover"
      },
      {
        "id": "G2",
        "page": "/dashboard/tasks",
        "flavour": "triage a free-text request into task fields"
      },
      {
        "id": "G3",
        "page": "/dashboard/worklog",
        "flavour": "turn rough notes into work-log entries tagged to a method phase"
      },
      {
        "id": "G4",
        "page": "/dashboard/ops/logs",
        "flavour": "read pasted text into: releases, defects"
      },
      {
        "id": "G5",
        "page": "/dashboard/reports-work",
        "flavour": "draft summary and recommendation text only; numbers come from the server"
      },
      {
        "id": "G6",
        "page": "/dashboard/automation",
        "flavour": "draft rules from plain language; dry-run before enabling"
      },
      {
        "id": "G8",
        "page": "/dashboard/ops",
        "flavour": "turn deterministic rule facts into recommendation text"
      },
      {
        "id": "G11",
        "page": "/dashboard/playbooks",
        "flavour": "draft playbook phases from procedure text using the Developer method"
      }
    ]
  },
  "needsConfirmation": [
    "KPI targets are unset (defaultTarget null): the owner and their manager must set them.",
    "Field names, enums and playbook titles are proposals: confirm against local practice."
  ]
