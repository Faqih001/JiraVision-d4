        },
        {
          "title": "Weekly order follow-up",
          "frequency": "weekly",
          "playbookKey": "weekly_order_follow_up"
        },
        {
          "title": "Quarterly supplier review",
          "frequency": "quarterly",
          "playbookKey": "quarterly_supplier_review"
