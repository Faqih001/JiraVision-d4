    "focus": "Requests, orders and supplier performance"
  },
  "pack": {
    "key": "finance",
    "reportTemplate": "assurance",
    "registerKinds": [
      "Accounts",
      "Audits",
      "Compliance",
      "Financial reports"
    ],
    "ladderDiscipline": {
      "proposed": "finance",
      "verifyIn": "lib/auto-populate.ts"
    }
  },
  "provenance": {
    "type": "proposed-seed",
    "sourceDocument": null,
    "reviewRequired": true,
    "reviewerRole": "experienced procurement practitioner",
    "note": "Starting seed written without a source document. Not professional, clinical, legal, financial or safety advice. A practitioner must review before use."
  },
  "method": {
    "resolveAtRuntime": "getMethodForDiscipline(pack, discipline)",
    "documentedSequence": null,
    "documentedIn": null
  },
  "surfaces": {
    "overview": {
      "path": "/dashboard/ops",
      "kpis": [
        {
          "id": "requests_approved",
          "label": "Requests approved",
          "source": "purchase_requests",
          "sourceType": "log",
          "aggregation": "count",
          "defaultTarget": null,
          "computedBy": "code"
        },
        {
          "id": "orders_received",
          "label": "Orders received",
          "source": "purchase_requests",
          "sourceType": "log",
          "aggregation": "count",
          "defaultTarget": null,
          "computedBy": "code"
        },
        {
          "id": "requests_awaiting_approval",
          "label": "Requests awaiting approval",
          "source": "purchase_requests",
          "sourceType": "log",
          "aggregation": "open_count",
          "defaultTarget": null,
          "computedBy": "code"
        },
        {
          "id": "suppliers_rated_low",
          "label": "Suppliers rated low",
          "source": "supplier_reviews",
          "sourceType": "log",
          "aggregation": "count",
          "defaultTarget": null,
          "computedBy": "code"
        }
      ],
      "recommendRules": [
        {
          "id": "request_pending_approval_over_3_days",
          "when": "request pending approval over 3 days",
          "suggest": "chase",
          "deterministic": true
        },
        {
          "id": "supplier_rated_low_twice",
          "when": "supplier rated low twice",
          "suggest": "review contract",
          "deterministic": true
        }
      ]
    },
    "logs": {
      "path": "/dashboard/ops/logs",
      "entities": [
        {
          "key": "purchase_requests",
          "label": "Purchase requests",
          "fields": [
            {
              "key": "request_date",
              "type": "date"
            },
            {
              "key": "item",
              "type": "text"
            },
            {
              "key": "approver",
              "type": "text"
            },
            {
              "key": "status",
              "type": "enum",
              "values": [
                "requested",
                "approved",
                "ordered",
                "received"
              ]
            }
          ]
        },
        {
          "key": "supplier_reviews",
          "label": "Supplier reviews",
          "fields": [
            {
              "key": "review_date",
              "type": "date"
            },
            {
              "key": "supplier",
              "type": "text"
            },
            {
              "key": "rating",
              "type": "enum",
              "values": [
                "low",
                "medium",
                "high"
              ]
            },
            {
              "key": "action",
              "type": "text"
            }
          ]
        }
      ]
    },
    "registers": {
      "path": "/dashboard/registers",
      "items": [
        {
          "kind": "Accounts",
          "track": [
            "vendor accounts"
          ]
        },
        {
          "kind": "Compliance",
          "track": [
            "procurement rules"
          ]
        },
        {
          "kind": "Audits",
          "track": [
            "procurement reviews"
          ]
        }
      ]
    },
    "playbooks": {
      "path": "/dashboard/playbooks",
