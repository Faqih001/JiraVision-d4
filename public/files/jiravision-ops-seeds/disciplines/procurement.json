        {
          "key": "daily_request_approvals",
          "title": "Daily request approvals",
          "frequency": "daily",
          "phasesFrom": "method"
        },
        {
          "key": "weekly_order_follow_up",
          "title": "Weekly order follow-up",
          "frequency": "weekly",
          "phasesFrom": "method"
        },
        {
          "key": "quarterly_supplier_review",
          "title": "Quarterly supplier review",
