# Copy to .env.local (git-ignored) and fill real values. Never commit secrets.

# Neon Postgres connection string (Vercel > Storage > Neon, or Neon console). Required; build fails without it.
DATABASE_URL=

# Public site URL, e.g. https://jiravision.vercel.app — used for emails and canonical links
NEXT_PUBLIC_APP_URL=

# Resend API key for transactional/contact emails — https://resend.com/api-keys
# Unset = emails are dev-logged to the server console instead of sent.
JIRAVISION_RESEND_API=

# Sender address for outgoing mail, e.g. "JiraVision <hello@jiravision.com>".
# Must be a domain verified in Resend (Resend > Domains) once the API key is set.
JIRAVISION_EMAIL_FROM=

# Inbox that receives contact/demo/quote/careers form submissions (defaults to info@jiravision.com).
# TODO(owner): confirm the real mailbox.
JIRAVISION_TEAM_EMAIL=

# Support address shown in transactional email footers (defaults to support@jiravision.com).
JIRAVISION_SUPPORT_EMAIL=

# Plausible domain for privacy-friendly analytics (plausible.io > Add Site).
# Analytics script only loads after the visitor grants "analytics" in the cookie consent panel;
# unset = track() calls are dev-logged only.
NEXT_PUBLIC_PLAUSUAL_DOMAIN=

# Custom WebSocket server URL for the chat features (legacy socket.io; the notification feed now uses Neon Realtime below). Defaults to app origin.
NEXT_PUBLIC_WEBSOCKET_URL=
NEXT_PUBLIC_SOCKET_URL=

# Set to "true" to enable test-only API behavior. Keep unset in production.
ENABLE_TEST_MODE=

# Google Maps embed key for /contact map. OWNER: the previous key was committed in source and must be revoked/rotated in Google Cloud Console, then set here.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ---- Neon platform services (populated by `neon deploy` / `neon env pull`) ----

# Neon Realtime (live SQL). From Neon console > Realtime, or `neon env pull --service realtime`.
# NEON_REALTIME_URL is server-side; NEXT_PUBLIC_NEON_REALTIME_URL is the same wss:// endpoint exposed to the browser.
NEON_REALTIME_URL=
NEON_REALTIME_SECRET=
NEXT_PUBLIC_NEON_REALTIME_URL=

# Managed Better Auth (provisioned but the app keeps its own cookie sessions; JWKS is used for token verification checks).
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=

# Neon Object Storage (S3-compatible). Credentials: Neon console > Storage > Credentials, or `neon deploy` with buckets in neon.ts.
# Path-style addressing is required by the app's S3 client.
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
# Bucket name for avatars/uploads (created by `neon deploy` from neon.ts). Defaults to "assets".
NEON_STORAGE_BUCKET=

# Neon Function base URL (public HTTPS). Deploy with `neon deploy` after declaring functions in neon.ts, then `neon env pull`.
# Unset = function-backed features degrade gracefully.
NEON_FUNCTION_HELLO_BASE_URL=

# Branch name recorded by the Neon CLI (informational).
NEON_BRANCH=

# Comma-separated emails granted super-admin access (CMS, admin APIs). Where to set: your own admin accounts.
ADMIN_EMAILS=
