# Copy to .env.local (git-ignored) and fill real values. Never commit secrets.

# Neon Postgres connection string (Vercel > Storage > Neon, or Neon console). Required; build fails without it.
DATABASE_URL=

# Public site URL, e.g. https://jiravision.vercel.app — used for emails and canonical links
NEXT_PUBLIC_APP_URL=

# Resend API key for transactional/contact emails — https://resend.com/api-keys
# Unset = emails are dev-logged to the server console instead of sent.
JIRAVISION_RESEND_API=

# Sender address for outgoing mail, e.g. "JiraVision <hello@jiravision.com>".
# Must be a domain verified in Resend (Resend > Domains) once the API key is set.
JIRAVISION_EMAIL_FROM=

# Inbox that receives contact/demo/quote/careers form submissions (defaults to info@jiravision.com).
# TODO(owner): confirm the real mailbox.
JIRAVISION_TEAM_EMAIL=

# Support address shown in transactional email footers (defaults to support@jiravision.com).
JIRAVISION_SUPPORT_EMAIL=

# Plausible domain for privacy-friendly analytics (plausible.io > Add Site).
# Analytics script only loads after the visitor grants "analytics" in the cookie consent panel;
# unset = track() calls are dev-logged only.
NEXT_PUBLIC_PLAUSUAL_DOMAIN=

# Custom WebSocket server URL for the chat features (socket.io). Defaults to app origin.
NEXT_PUBLIC_WEBSOCKET_URL=
NEXT_PUBLIC_SOCKET_URL=

# Set to "true" to enable test-only API behavior. Keep unset in production.
ENABLE_TEST_MODE=

# Google Maps embed key for /contact map. OWNER: the previous key was committed in source and must be revoked/rotated in Google Cloud Console, then set here.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
